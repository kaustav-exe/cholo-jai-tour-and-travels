# Sanity.io Content Management System Configuration
PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-03-01
SANITY_API_TOKEN=your_sanity_write_token

# AI / Voice Engine Configuration (Optional for live LLM responses)
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Meta / Facebook Graph API (Optional for automated token-based feed)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token
