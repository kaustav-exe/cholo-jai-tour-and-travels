---
import { facebookReels, facebookPageUrl } from '../data/facebookReels';
import { Play, Eye, Heart, ChevronLeft, ChevronRight, ExternalLink, X, Volume2, VolumeX, Sparkles, CheckCircle2 } from 'lucide-astro';
---

<section class="section fb-reels-section" id="facebook-reels">
  <div class="container">

    <!-- Premium Social Header -->
    <div class="fb-header-wrap">
      <div class="fb-header-left">
        <div class="fb-badge-row">
          <span class="fb-icon-pill">
            <svg class="fb-svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span>Official Facebook Page</span>
          </span>
          <span class="fb-live-dot" title="Active on Facebook">
            <span class="pulse-dot"></span> Active Community
          </span>
        </div>
        <h2 class="fb-section-title">Watch Our Latest Tour Reels &amp; Moments</h2>
        <p class="fb-section-desc">
          Real travel moments captured across our tours. Swipe through our latest Facebook Reels or follow our page for daily updates and tour announcements.
        </p>
      </div>

      <div class="fb-header-right">
        <a 
          href={facebookPageUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-fb-follow"
          title="Visit and follow Cholo Jai Tour & Travels on Facebook"
        >
          <svg class="fb-svg-white" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          <span>Follow on Facebook</span>
          <ExternalLink size={14} class="ext-ico" />
        </a>

        <!-- Carousel Navigation Arrows -->
        <div class="carousel-nav-btns">
          <button type="button" class="nav-btn prev-btn" id="fb-reels-prev" aria-label="Previous Reels">
            <ChevronLeft size={20} />
          </button>
          <button type="button" class="nav-btn next-btn" id="fb-reels-next" aria-label="Next Reels">
            <ChevronRight size={20} />
          </button>
        </div>
      </div>
    </div>

    <!-- Horizontal Reel Carousel Track -->
    <div class="fb-carousel-container">
      <div class="fb-reels-track" id="fb-reels-track">
        {facebookReels.map((reel, idx) => (
          <article 
            class="reel-card" 
            data-index={idx}
            data-title={reel.title}
            data-destination={reel.destination}
            data-video-url={reel.videoUrl}
            data-fb-url={reel.facebookUrl}
            data-views={reel.views}
            data-likes={reel.likes}
          >
            <div class="reel-card-inner">
              <img 
                src={reel.thumbnail} 
                alt={reel.title} 
                class="reel-poster" 
                loading="lazy" 
              />
              <div class="reel-overlay-gradient"></div>

              <!-- Top Tags -->
              <div class="reel-top-bar">
                <span class="reel-dest-pill">{reel.destination}</span>
                <span class="reel-fb-badge" title="Facebook Reel">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="#ffffff">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                  <span>Reel</span>
                </span>
              </div>

              <!-- Center Play Icon Glow -->
              <div class="reel-center-play">
                <div class="play-circle">
                  <Play size={22} fill="#ffffff" color="#ffffff" class="play-icon" />
                </div>
              </div>

              <!-- Bottom Content -->
              <div class="reel-bottom-bar">
                <p class="reel-title">{reel.title}</p>
                <div class="reel-meta-row">
                  <span class="reel-stat"><Eye size={12} /> {reel.views}</span>
                  <span class="reel-stat"><Heart size={12} fill="#ef4444" color="#ef4444" /> {reel.likes}</span>
                  <span class="reel-duration">{reel.duration}</span>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Mobile Swipe Helper Indicator -->
    <div class="swipe-hint-bar mobile-only">
      <span>← Swipe horizontally to browse more Reels →</span>
    </div>

  </div>
</section>

<!-- In-Site Interactive Reel Video Modal -->
<div class="reel-modal-overlay" id="reel-modal" aria-hidden="true">
  <div class="reel-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="reel-modal-title">
    <button class="reel-modal-close" id="reel-modal-close" aria-label="Close Reel Player" type="button">
      <X size={20} />
    </button>

    <div class="reel-player-container">
      <video 
        id="reel-modal-video" 
        class="reel-modal-video" 
        playsinline 
        webkit-playsinline 
        preload="none"
        loop
      >
        <source id="reel-modal-source" src="" type="video/mp4" />
      </video>

      <!-- Video Controls Overlay -->
      <div class="reel-player-controls">
        <button type="button" class="btn-sound-toggle" id="reel-sound-btn" aria-label="Toggle Sound">
          <Volume2 size={18} id="sound-on-icon" />
          <VolumeX size={18} id="sound-off-icon" style="display:none;" />
        </button>
      </div>

      <!-- In-Modal Footer Info & Facebook Action -->
      <div class="reel-modal-footer">
        <div class="reel-modal-info">
          <span class="modal-dest-tag" id="reel-modal-dest">Kashmir</span>
          <h3 class="modal-video-title" id="reel-modal-title">Reel Title</h3>
          <div class="modal-stats-row">
            <span id="reel-modal-views"><Eye size={13}/> 18.4K views</span>
            <span id="reel-modal-likes"><Heart size={13} fill="#ef4444" color="#ef4444"/> 2.1K likes</span>
          </div>
        </div>

        <a 
          href={facebookPageUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          id="reel-modal-fb-link" 
          class="btn-modal-fb"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="#ffffff">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          <span>Watch on Facebook</span>
          <ExternalLink size={13} />
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  function initFacebookReels() {
    const track = document.getElementById('fb-reels-track');
    const prevBtn = document.getElementById('fb-reels-prev');
    const nextBtn = document.getElementById('fb-reels-next');
    const modal = document.getElementById('reel-modal');
    const modalClose = document.getElementById('reel-modal-close');
    const video = document.getElementById('reel-modal-video') as HTMLVideoElement | null;
    const source = document.getElementById('reel-modal-source') as HTMLSourceElement | null;
    const modalTitle = document.getElementById('reel-modal-title');
    const modalDest = document.getElementById('reel-modal-dest');
    const modalViews = document.getElementById('reel-modal-views');
    const modalLikes = document.getElementById('reel-modal-likes');
    const modalFbLink = document.getElementById('reel-modal-fb-link') as HTMLAnchorElement | null;
    const soundBtn = document.getElementById('reel-sound-btn');
    const soundOn = document.getElementById('sound-on-icon');
    const soundOff = document.getElementById('sound-off-icon');

    if (!track) return;

    // -- Horizontal Scroll Buttons --
    const scrollAmount = 320;
    prevBtn?.addEventListener('click', () => {
      track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });
    nextBtn?.addEventListener('click', () => {
      track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });

    // -- Mouse Drag-to-Scroll for Desktop --
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;
    let hasDragged = false;

    track.addEventListener('mousedown', (e) => {
      isDown = true;
      hasDragged = false;
      track.classList.add('active-dragging');
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
    });

    window.addEventListener('mouseup', () => {
      if (!isDown) return;
      isDown = false;
      track.classList.remove('active-dragging');
    });

    track.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.5;
      if (Math.abs(walk) > 5) hasDragged = true;
      track.scrollLeft = scrollLeft - walk;
    });

    // -- Click-to-Play Modal Handler --
    const cards = track.querySelectorAll<HTMLElement>('.reel-card');
    cards.forEach(card => {
      card.addEventListener('click', (e) => {
        if (hasDragged) return; // Ignore drag release
        const title = card.dataset.title || '';
        const dest = card.dataset.destination || '';
        const videoUrl = card.dataset.videoUrl || '';
        const fbUrl = card.dataset.fbUrl || '';
        const views = card.dataset.views || '';
        const likes = card.dataset.likes || '';

        openReelModal(title, dest, videoUrl, fbUrl, views, likes);
      });
    });

    function openReelModal(title: string, dest: string, videoUrl: string, fbUrl: string, views: string, likes: string) {
      if (!modal || !video || !source) return;

      if (modalTitle) modalTitle.textContent = title;
      if (modalDest) modalDest.textContent = dest;
      if (modalViews) modalViews.innerHTML = `<span>👁️ ${views} views</span>`;
      if (modalLikes) modalLikes.innerHTML = `<span>❤️ ${likes} likes</span>`;
      if (modalFbLink && fbUrl) modalFbLink.href = fbUrl;

      // Set and play video
      source.src = videoUrl;
      video.load();
      video.muted = false;
      video.volume = 1.0;
      updateSoundIcons(false);

      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      video.play().catch(() => {
        // If unmuted autoplay blocked, mute and play
        video.muted = true;
        updateSoundIcons(true);
        video.play().catch(() => {});
      });
    }

    function closeReelModal() {
      if (!modal || !video) return;
      video.pause();
      video.currentTime = 0;
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    modalClose?.addEventListener('click', closeReelModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeReelModal();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal?.classList.contains('open')) {
        closeReelModal();
      }
    });

    // Sound toggle
    function updateSoundIcons(isMuted: boolean) {
      if (soundOn && soundOff) {
        soundOn.style.display = isMuted ? 'none' : 'block';
        soundOff.style.display = isMuted ? 'block' : 'none';
      }
    }

    soundBtn?.addEventListener('click', () => {
      if (!video) return;
      video.muted = !video.muted;
      updateSoundIcons(video.muted);
    });
  }

  document.addEventListener('astro:page-load', initFacebookReels);
  initFacebookReels();
</script>

<style>
  .fb-reels-section {
    background-color: #0F172A;
    color: #ffffff;
    padding: 70px 0 80px;
    position: relative;
    overflow: hidden;
  }

  /* Subtle background radial glow */
  .fb-reels-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 20%;
    width: 600px;
    height: 400px;
    background: radial-gradient(circle, rgba(24, 119, 242, 0.12) 0%, rgba(15, 23, 42, 0) 70%);
    pointer-events: none;
  }

  /* ── Header Area ── */
  .fb-header-wrap {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 36px;
    flex-wrap: wrap;
    gap: 24px;
  }

  .fb-header-left {
    max-width: 680px;
  }

  .fb-badge-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .fb-icon-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(24, 119, 242, 0.18);
    color: #60A5FA;
    border: 1px solid rgba(24, 119, 242, 0.4);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
    font-family: var(--f-heading);
    letter-spacing: 0.02em;
  }

  .fb-svg {
    fill: #1877F2;
  }

  .fb-live-dot {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #94A3B8;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #22C55E;
    border-radius: 50%;
    box-shadow: 0 0 8px #22C55E;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.2); opacity: 1; }
    100% { transform: scale(0.95); opacity: 0.8; }
  }

  .fb-section-title {
    color: #ffffff;
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: 12px;
    font-family: var(--f-heading);
  }

  .fb-section-desc {
    color: #94A3B8;
    font-size: 0.98rem;
    line-height: 1.6;
    margin: 0;
  }

  .fb-header-right {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn-fb-follow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1877F2;
    color: #ffffff;
    padding: 11px 22px;
    border-radius: 10px;
    font-family: var(--f-heading);
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(24, 119, 242, 0.35);
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    white-space: nowrap;
  }

  .btn-fb-follow:hover {
    background: #1565C0;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(24, 119, 242, 0.45);
  }

  .fb-svg-white {
    fill: #ffffff;
    flex-shrink: 0;
  }

  .ext-ico {
    opacity: 0.8;
  }

  .carousel-nav-btns {
    display: flex;
    gap: 8px;
  }

  .nav-btn {
    width: 42px;
    height: 42px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .nav-btn:hover {
    background: #1877F2;
    border-color: #1877F2;
    transform: scale(1.05);
  }

  /* ── Horizontal Carousel Track ── */
  .fb-carousel-container {
    position: relative;
    width: 100%;
    margin-top: 10px;
  }

  .fb-reels-track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 10px 4px 20px;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE */
    cursor: grab;
    user-select: none;
  }

  .fb-reels-track::-webkit-scrollbar {
    display: none; /* Chrome / Safari */
  }

  .fb-reels-track.active-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
  }

  /* ── 9:16 Vertical Reel Card ── */
  .reel-card {
    flex: 0 0 240px;
    width: 240px;
    height: 390px;
    border-radius: 18px;
    overflow: hidden;
    position: relative;
    scroll-snap-align: start;
    cursor: pointer;
    background: #1E293B;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    transition: transform 0.3s cubic-bezier(0.2, 0, 0.2, 1), box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .reel-card:hover {
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 18px 40px rgba(24, 119, 242, 0.25);
    border-color: rgba(96, 165, 250, 0.6);
  }

  .reel-card-inner {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 14px;
  }

  .reel-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .reel-card:hover .reel-poster {
    transform: scale(1.06);
  }

  .reel-overlay-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 23, 42, 0.45) 0%,
      rgba(15, 23, 42, 0.1) 40%,
      rgba(15, 23, 42, 0.85) 80%,
      rgba(15, 23, 42, 0.98) 100%
    );
    pointer-events: none;
  }

  .reel-top-bar {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .reel-dest-pill {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(6px);
    color: #FFD166;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 12px;
    border: 1px solid rgba(255, 209, 102, 0.3);
  }

  .reel-fb-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #1877F2;
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 12px;
  }

  .reel-center-play {
    position: absolute;
    top: 45%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  .play-circle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(24, 119, 242, 0.85);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
    transition: transform 0.25s ease, background 0.25s ease;
  }

  .play-icon {
    margin-left: 3px;
  }

  .reel-card:hover .play-circle {
    transform: scale(1.15);
    background: #1877F2;
  }

  .reel-bottom-bar {
    position: relative;
    z-index: 2;
    margin-top: auto;
  }

  .reel-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.35;
    margin-bottom: 8px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .reel-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    color: #CBD5E1;
  }

  .reel-stat {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .reel-duration {
    background: rgba(255, 255, 255, 0.15);
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 600;
  }

  .swipe-hint-bar {
    text-align: center;
    color: #64748B;
    font-size: 0.78rem;
    margin-top: 14px;
  }

  .mobile-only {
    display: none;
  }

  /* ── In-Site Reel Modal Player ── */
  .reel-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .reel-modal-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .reel-modal-dialog {
    position: relative;
    width: 100%;
    max-width: 420px;
    max-height: 90dvh;
    background: #000000;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.15);
    transform: translateY(20px) scale(0.96);
    transition: transform 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .reel-modal-overlay.open .reel-modal-dialog {
    transform: translateY(0) scale(1);
  }

  .reel-modal-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    background: rgba(0, 0, 0, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    color: #ffffff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: background 0.2s ease;
  }

  .reel-modal-close:hover {
    background: #ef4444;
  }

  .reel-player-container {
    position: relative;
    width: 100%;
    height: clamp(520px, 80vh, 680px);
    background: #000000;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

