---
import { facebookReels, facebookPageUrl } from '../data/facebookReels';
import { Play, Eye, Heart, ChevronLeft, ChevronRight, ExternalLink, X, CheckCircle2, MonitorPlay, ArrowLeft } from 'lucide-astro';
---

<section class="section fb-reels-section" id="facebook-reels">
  <div class="container">

    <!-- Premium Social Header -->
    <div class="fb-header-wrap">
      <div class="fb-header-left">
        <div class="fb-badge-row">
          <span class="fb-icon-pill">
            <svg class="fb-svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span>Facebook Reels</span>
          </span>
          <span class="fb-live-dot" title="Active on Facebook">
            <span class="pulse-dot"></span> Live on Facebook
          </span>
        </div>
        <h2 class="fb-section-title">Watch Our Travel Stories &amp; Reels</h2>
        <p class="fb-section-desc">
          Click any card to preview the Reel — then play it directly here or watch on Facebook.
        </p>
      </div>

      <div class="fb-header-right">
        <a 
          href={facebookPageUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-fb-follow"
          title="Visit and follow Cholo Jai Tour & Travels on Facebook"
        >
          <svg class="fb-svg-white" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          <span>Follow on Facebook</span>
          <ExternalLink size={14} class="ext-ico" />
        </a>

        <!-- Carousel Navigation Arrows -->
        <div class="carousel-nav-btns">
          <button type="button" class="nav-btn prev-btn" id="fb-reels-prev" aria-label="Previous Reels">
            <ChevronLeft size={20} />
          </button>
          <button type="button" class="nav-btn next-btn" id="fb-reels-next" aria-label="Next Reels">
            <ChevronRight size={20} />
          </button>
        </div>
      </div>
    </div>

    <!-- 5 Recent Reel Cards Horizontal Carousel -->
    <div class="fb-carousel-container">
      <div class="fb-reels-track" id="fb-reels-track">
        {facebookReels.map((reel, idx) => (
          <article 
            class="reel-card" 
            data-index={idx}
            data-title={reel.title}
            data-destination={reel.destination}
            data-poster={reel.thumbnail}
            data-fb-url={reel.facebookUrl}
            data-views={reel.views}
            data-likes={reel.likes}
            data-duration={reel.duration}
            tabindex="0"
            role="button"
            aria-label={`Preview ${reel.destination} Facebook Reel`}
          >
            <div class="reel-card-inner">
              <img 
                src={reel.thumbnail} 
                alt={reel.title} 
                class="reel-poster" 
                loading="lazy" 
              />
              <div class="reel-overlay-gradient"></div>

              <!-- Top Tags -->
              <div class="reel-top-bar">
                <span class="reel-dest-pill">{reel.destination}</span>
                <span class="reel-fb-badge" title="Facebook Reel">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="#ffffff">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                  <span>Reel #{idx + 1}</span>
                </span>
              </div>

              <!-- Center Play Icon Glow -->
              <div class="reel-center-play">
                <div class="play-circle">
                  <Play size={24} fill="#ffffff" color="#ffffff" class="play-icon" />
                </div>
                <span class="watch-hint">Watch Reel</span>
              </div>

              <!-- Bottom Content -->
              <div class="reel-bottom-bar">
                <p class="reel-title">{reel.title}</p>
                <div class="reel-meta-row">
                  <span class="reel-stat"><Eye size={12} /> {reel.views}</span>
                  <span class="reel-stat"><Heart size={12} fill="#ef4444" color="#ef4444" /> {reel.likes}</span>
                  <span class="reel-duration">{reel.duration}</span>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Mobile Swipe Helper Indicator -->
    <div class="swipe-hint-bar mobile-only">
      <span>← Swipe horizontally to browse more Reels →</span>
    </div>

  </div>
</section>

<!-- Reel Modal — Two Panels: Preview (default) & Embed Player (on request) -->
<div class="reel-modal-overlay" id="reel-modal" aria-hidden="true">
  <div class="reel-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="reel-modal-title">

    <!-- Close Button -->
    <button class="reel-modal-close" id="reel-modal-close" aria-label="Close Reel Preview" type="button">
      <X size={20} />
    </button>

    <!-- PANEL 1: Preview State (default, never broken) -->
    <div class="modal-panel preview-panel" id="modal-preview-panel">
      <!-- Thumbnail Background -->
      <div class="preview-bg" id="preview-bg"></div>
      <div class="preview-overlay"></div>

      <!-- Content -->
      <div class="preview-content">
        <!-- Destination + Brand -->
        <div class="preview-top-row">
          <span class="preview-dest-tag" id="preview-dest-tag">Kashmir</span>
          <div class="preview-brand">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="#1877f2">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span>চলো যাই ট্যুর &amp; ট্রাভেলস</span>
            <CheckCircle2 size={13} class="verified-icon" />
          </div>
        </div>

        <!-- Title -->
        <h3 class="preview-title" id="reel-modal-title">Reel Title</h3>

        <!-- Stats -->
        <div class="preview-stats-row">
          <span id="preview-views">👁️ 18.4K views</span>
          <span id="preview-likes">❤️ 2.1K likes</span>
          <span id="preview-duration" class="preview-dur-pill">0:45</span>
        </div>

        <!-- Action Buttons -->
        <div class="preview-actions">
          <!-- Try in-site embed -->
          <button type="button" class="btn-try-embed" id="btn-try-embed" aria-label="Try playing this reel inside the website">
            <MonitorPlay size={18} />
            <span>Try Playing Here</span>
          </button>

          <!-- Direct reel link — ALWAYS points to exact reel URL -->
          <a 
            href="#" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-watch-fb" 
            id="btn-watch-fb"
            aria-label="Watch original reel on Facebook"
          >
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span>Watch on Facebook</span>
            <ExternalLink size={13} />
          </a>
        </div>

        <p class="preview-hint">Click "Try Playing Here" to embed the original Facebook Reel inline.</p>
      </div>
    </div>

    <!-- PANEL 2: Embed Player State (shown only when user requests) -->
    <div class="modal-panel player-panel hidden" id="modal-player-panel">
      <!-- Back to preview button -->
      <button type="button" class="btn-back-preview" id="btn-back-preview" aria-label="Back to preview">
        <ArrowLeft size={16} />
        <span>Back</span>
      </button>

      <!-- Embed container -->
      <div class="embed-container" id="embed-container">
        <div class="embed-spinner" id="embed-spinner">
          <div class="spinner-ring"></div>
          <span>Loading Facebook Reel...</span>
        </div>
        <iframe
          id="reel-fb-iframe"
          src=""
          width="100%"
          height="100%"
          style="border:none;overflow:hidden;width:100%;height:100%;display:block;"
          scrolling="no"
          frameborder="0"
          allowfullscreen="true"
          allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
          title="Facebook Reel Player"
        ></iframe>
      </div>

      <!-- Footer with fallback link (always visible in player state) -->
      <div class="player-footer">
        <span class="player-footer-label">Not playing?</span>
        <a 
          href="#" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-player-fb-link" 
          id="btn-player-fb-link"
        >
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          Watch this Reel on Facebook →
        </a>
      </div>
    </div>

  </div>
</div>

<script>
  function initFacebookReels() {
    const track = document.getElementById('fb-reels-track');
    const prevBtn = document.getElementById('fb-reels-prev');
    const nextBtn = document.getElementById('fb-reels-next');
    const modal = document.getElementById('reel-modal');
    const modalClose = document.getElementById('reel-modal-close');

    // Preview panel elements
    const previewPanel = document.getElementById('modal-preview-panel');
    const previewBg = document.getElementById('preview-bg');
    const previewDestTag = document.getElementById('preview-dest-tag');
    const previewTitle = document.getElementById('reel-modal-title');
    const previewViews = document.getElementById('preview-views');
    const previewLikes = document.getElementById('preview-likes');
    const previewDuration = document.getElementById('preview-duration');
    const btnTryEmbed = document.getElementById('btn-try-embed');
    const btnWatchFb = document.getElementById('btn-watch-fb') as HTMLAnchorElement | null;

    // Player panel elements
    const playerPanel = document.getElementById('modal-player-panel');
    const embedSpinner = document.getElementById('embed-spinner');
    const fbIframe = document.getElementById('reel-fb-iframe') as HTMLIFrameElement | null;
    const btnBackPreview = document.getElementById('btn-back-preview');
    const btnPlayerFbLink = document.getElementById('btn-player-fb-link') as HTMLAnchorElement | null;

    if (!track) return;

    // Store current reel URL
    let currentReelUrl = '';

    // ── Carousel Navigation ──────────────────────────────────────
    if (prevBtn && nextBtn) {
      const scrollStep = 300;
      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -scrollStep, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: scrollStep, behavior: 'smooth' });
      });
    }

    // ── Desktop Mouse Drag ───────────────────────────────────────
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;
    let hasMoved = false;

    track.addEventListener('mousedown', (e) => {
      isDown = true;
      hasMoved = false;
      track.classList.add('is-dragging');
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
    });

    track.addEventListener('mouseleave', () => {
      isDown = false;
      track.classList.remove('is-dragging');
    });

    track.addEventListener('mouseup', () => {
      isDown = false;
      setTimeout(() => { track.classList.remove('is-dragging'); }, 50);
    });

    track.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.5;
      if (Math.abs(walk) > 5) hasMoved = true;
      track.scrollLeft = scrollLeft - walk;
    });

    // ── Show Modal in Preview State ──────────────────────────────
    function showPreviewPanel() {
      previewPanel?.classList.remove('hidden');
      playerPanel?.classList.add('hidden');
    }

    function showPlayerPanel() {
      previewPanel?.classList.add('hidden');
      playerPanel?.classList.remove('hidden');
    }

    // ── Open Modal ───────────────────────────────────────────────
    function openModal(card: HTMLElement) {
      const title = card.dataset.title || '';
      const destination = card.dataset.destination || '';
      const poster = card.dataset.poster || '';
      const fbUrl = card.dataset.fbUrl || '';
      const views = card.dataset.views || '';
      const likes = card.dataset.likes || '';
      const duration = card.dataset.duration || '';

      currentReelUrl = fbUrl;

      // Populate preview panel
      if (previewBg) previewBg.style.backgroundImage = `url('${poster}')`;
      if (previewDestTag) previewDestTag.textContent = destination;
      if (previewTitle) previewTitle.textContent = title;
      if (previewViews) previewViews.textContent = `👁️ ${views} views`;
      if (previewLikes) previewLikes.textContent = `❤️ ${likes} likes`;
      if (previewDuration) previewDuration.textContent = duration;

      // Set direct reel links
      if (btnWatchFb) btnWatchFb.href = fbUrl;
      if (btnPlayerFbLink) btnPlayerFbLink.href = fbUrl;

      // Reset to preview state
      showPreviewPanel();
      resetEmbedState();

      // Show modal
      modal?.setAttribute('aria-hidden', 'false');
      modal?.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    // ── Try Embed ────────────────────────────────────────────────
    function tryEmbed() {
      if (!currentReelUrl) return;

      showPlayerPanel();

      // Show spinner, hide iframe
      if (embedSpinner) embedSpinner.style.display = 'flex';
      if (fbIframe) {
        fbIframe.style.opacity = '0';

        // Construct Facebook official video embed URL
        const embedUrl = `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(currentReelUrl)}&show_text=false&autoplay=true&mute=false&width=340`;

        fbIframe.src = embedUrl;

        fbIframe.onload = () => {
          if (embedSpinner) embedSpinner.style.display = 'none';
          if (fbIframe) fbIframe.style.opacity = '1';
        };
      }
    }

    // ── Reset Embed State ────────────────────────────────────────
    function resetEmbedState() {
      if (fbIframe) {
        fbIframe.src = '';
        fbIframe.style.opacity = '0';
      }
      if (embedSpinner) embedSpinner.style.display = 'flex';
    }

    // ── Close Modal ──────────────────────────────────────────────
    function closeModal() {
      modal?.setAttribute('aria-hidden', 'true');
      modal?.classList.remove('active');
      document.body.style.overflow = '';
      resetEmbedState();
      currentReelUrl = '';
    }

    // ── Reel Card Click ──────────────────────────────────────────
    const reelCards = document.querySelectorAll<HTMLElement>('.reel-card');
    reelCards.forEach((card) => {
      card.addEventListener('click', (e) => {
        if (hasMoved) return;
        e.preventDefault();
        openModal(card);
      });

      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openModal(card);
        }
      });
    });

    // ── Try Embed Button ─────────────────────────────────────────
    btnTryEmbed?.addEventListener('click', tryEmbed);

    // ── Back to Preview ──────────────────────────────────────────
    btnBackPreview?.addEventListener('click', () => {
      showPreviewPanel();
      resetEmbedState();
    });

    // ── Close Controls ───────────────────────────────────────────
    modalClose?.addEventListener('click', closeModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal?.classList.contains('active')) closeModal();
    });
  }

  document.addEventListener('astro:page-load', initFacebookReels);
  initFacebookReels();
</script>

<style>
  /* ── Section ──────────────────────────────────────────────── */
  .fb-reels-section {
    background: linear-gradient(180deg, #f8fafc 0%, #eef2f6 100%);
    padding: 70px 0 80px;
    position: relative;
    overflow: hidden;
  }

  /* ── Header ──────────────────────────────────────────────── */
  .fb-header-wrap {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
    gap: 24px;
    flex-wrap: wrap;
  }

  .fb-badge-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .fb-icon-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #e7f3ff;
    color: #1877f2;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.3px;
  }

  .fb-svg { fill: #1877f2; }

  .fb-live-dot {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: #059669;
    font-weight: 600;
    background: #ecfdf5;
    padding: 6px 12px;
    border-radius: 20px;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: pulse-green 1.8s infinite;
  }

  @keyframes pulse-green {
    0%   { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70%  { transform: scale(1);    box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);  }
  }

  .fb-section-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--c-primary, #0d2847);
    line-height: 1.25;
    margin-bottom: 8px;
  }

  .fb-section-desc {
    color: var(--c-text-light, #4b5563);
    font-size: 1.05rem;
    max-width: 620px;
    line-height: 1.5;
    margin: 0;
  }

  .fb-header-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .btn-fb-follow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1877f2;
    color: #ffffff !important;
    padding: 12px 22px;
    border-radius: 30px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(24, 119, 242, 0.35);
    transition: all 0.25s ease;
  }

  .btn-fb-follow:hover {
    background: #0d65d9;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(24, 119, 242, 0.45);
  }

  .carousel-nav-btns { display: flex; gap: 8px; }

  .nav-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid #d1d5db;
    background: #ffffff;
    color: #1f2937;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 2px 6px rgba(0,0,0,0.05);
  }

  .nav-btn:hover {
    background: var(--c-primary, #0d2847);
    color: #ffffff;
    border-color: var(--c-primary, #0d2847);
    transform: scale(1.05);
  }

  /* ── Carousel ─────────────────────────────────────────────── */
  .fb-carousel-container { position: relative; width: 100%; }

  .fb-reels-track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 12px 4px 20px;
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
    cursor: grab;
    -webkit-overflow-scrolling: touch;
  }

  .fb-reels-track.is-dragging { cursor: grabbing; user-select: none; scroll-snap-type: none; }
  .fb-reels-track::-webkit-scrollbar { height: 6px; }
  .fb-reels-track::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }

  /* ── Reel Card ────────────────────────────────────────────── */
  .reel-card {
    flex: 0 0 240px;
    width: 240px;
    height: 420px;
    scroll-snap-align: start;
    border-radius: 18px;
    overflow: hidden;
    position: relative;
    background: #111827;
    cursor: pointer;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
  }

  .reel-card:hover, .reel-card:focus {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 16px 36px rgba(24, 119, 242, 0.3);
  }

  .reel-card-inner {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 16px;
  }

  .reel-poster {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .reel-card:hover .reel-poster { transform: scale(1.08); }

  .reel-overlay-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0) 35%, rgba(0,0,0,0.2) 60%, rgba(0,0,0,0.92) 100%);
    pointer-events: none;
  }

  .reel-top-bar {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .reel-dest-pill {
    background: rgba(0,0,0,0.65);
    backdrop-filter: blur(8px);
    color: #ffffff;
