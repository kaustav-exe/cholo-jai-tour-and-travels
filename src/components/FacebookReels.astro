---
import { facebookReels, facebookPageUrl } from '../data/facebookReels';
import { Play, Eye, Heart, ChevronLeft, ChevronRight, ExternalLink, X, CheckCircle2 } from 'lucide-astro';
---

<section class="section fb-reels-section" id="facebook-reels">
  <div class="container">

    <!-- Premium Social Header -->
    <div class="fb-header-wrap">
      <div class="fb-header-left">
        <div class="fb-badge-row">
          <span class="fb-icon-pill">
            <svg class="fb-svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span>Official Facebook Reels</span>
          </span>
          <span class="fb-live-dot" title="Active on Facebook">
            <span class="pulse-dot"></span> In-Site Player
          </span>
        </div>
        <h2 class="fb-section-title">Watch Our Travel Stories &amp; Reels</h2>
        <p class="fb-section-desc">
          Click any card to watch the original Facebook Reel directly inside our website.
        </p>
      </div>

      <div class="fb-header-right">
        <a 
          href={facebookPageUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-fb-follow"
          title="Visit and follow Cholo Jai Tour & Travels on Facebook"
        >
          <svg class="fb-svg-white" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          <span>Follow on Facebook</span>
          <ExternalLink size={14} class="ext-ico" />
        </a>

        <!-- Carousel Navigation Arrows -->
        <div class="carousel-nav-btns">
          <button type="button" class="nav-btn prev-btn" id="fb-reels-prev" aria-label="Previous Reels">
            <ChevronLeft size={20} />
          </button>
          <button type="button" class="nav-btn next-btn" id="fb-reels-next" aria-label="Next Reels">
            <ChevronRight size={20} />
          </button>
        </div>
      </div>
    </div>

    <!-- 5 Recent Reel Cards Horizontal Carousel -->
    <div class="fb-carousel-container">
      <div class="fb-reels-track" id="fb-reels-track">
        {facebookReels.map((reel, idx) => (
          <article 
            class="reel-card" 
            data-index={idx}
            data-title={reel.title}
            data-destination={reel.destination}
            data-poster={reel.thumbnail}
            data-fb-url={reel.facebookUrl}
            data-views={reel.views}
            data-likes={reel.likes}
            data-duration={reel.duration}
            tabindex="0"
            role="button"
            aria-label={`Play ${reel.destination} Facebook Reel`}
          >
            <div class="reel-card-inner">
              <img 
                src={reel.thumbnail} 
                alt={reel.title} 
                class="reel-poster" 
                loading="lazy" 
              />
              <div class="reel-overlay-gradient"></div>

              <!-- Top Tags -->
              <div class="reel-top-bar">
                <span class="reel-dest-pill">{reel.destination}</span>
                <span class="reel-fb-badge" title="Facebook Reel">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="#ffffff">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                  <span>Reel #{idx + 1}</span>
                </span>
              </div>

              <!-- Center Play Icon Glow -->
              <div class="reel-center-play">
                <div class="play-circle">
                  <Play size={24} fill="#ffffff" color="#ffffff" class="play-icon" />
                </div>
                <span class="watch-hint">Watch Reel</span>
              </div>

              <!-- Bottom Content -->
              <div class="reel-bottom-bar">
                <p class="reel-title">{reel.title}</p>
                <div class="reel-meta-row">
                  <span class="reel-stat"><Eye size={12} /> {reel.views}</span>
                  <span class="reel-stat"><Heart size={12} fill="#ef4444" color="#ef4444" /> {reel.likes}</span>
                  <span class="reel-duration">{reel.duration}</span>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Mobile Swipe Helper Indicator -->
    <div class="swipe-hint-bar mobile-only">
      <span>← Swipe horizontally to browse more Reels →</span>
    </div>

  </div>
</section>

<!-- In-Site Original Facebook Reel Player Modal -->
<div class="reel-modal-overlay" id="reel-modal" aria-hidden="true">
  <div class="reel-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="reel-modal-title">
    <button class="reel-modal-close" id="reel-modal-close" aria-label="Close Reel Player" type="button">
      <X size={20} />
    </button>

    <div class="reel-player-container">
      <!-- Original Facebook Embedded Video Player Container -->
      <div class="reel-embed-frame" id="reel-embed-frame">
        <!-- Facebook Video Iframe (Injected Lazily on Click) -->
        <iframe 
          id="reel-fb-iframe" 
          src="" 
          width="100%" 
          height="100%" 
          style="border:none;overflow:hidden;width:100%;height:100%;" 
          scrolling="no" 
          frameborder="0" 
          allowfullscreen="true" 
          allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
          loading="lazy"
          title="Facebook Reel Player"
        ></iframe>

        <!-- Loading Spinner Placeholder -->
        <div class="reel-loading-spinner" id="reel-loading-spinner">
          <div class="spinner-ring"></div>
          <span>Loading Facebook Reel...</span>
        </div>
      </div>

      <!-- In-Modal Footer Info & Direct Facebook Action -->
      <div class="reel-modal-footer">
        <div class="reel-modal-info">
          <div class="reel-author-row">
            <span class="modal-dest-tag" id="reel-modal-dest">Kashmir</span>
            <div class="author-tag">
              <span class="author-name">চলো যাই ট্যুর &amp; ট্রাভেলস</span>
              <CheckCircle2 size={13} class="verified-icon" />
            </div>
          </div>

          <h3 class="modal-video-title" id="reel-modal-title">Reel Title</h3>
          
          <div class="modal-stats-row">
            <span id="reel-modal-views"><Eye size={13}/> 18.4K views</span>
            <span id="reel-modal-likes"><Heart size={13} fill="#ef4444" color="#ef4444"/> 2.1K likes</span>
          </div>
        </div>

        <div class="modal-actions-row">
          <a 
            href={facebookPageUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-modal-fb-direct"
            id="reel-modal-fb-link"
          >
            <svg viewBox="0 0 24 24" width="15" height="15" fill="#ffffff">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span>Follow on Facebook</span>
            <ExternalLink size={13} />
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initFacebookReels() {
    const track = document.getElementById('fb-reels-track');
    const prevBtn = document.getElementById('fb-reels-prev');
    const nextBtn = document.getElementById('fb-reels-next');
    const modal = document.getElementById('reel-modal');
    const modalClose = document.getElementById('reel-modal-close');
    const fbIframe = document.getElementById('reel-fb-iframe') as HTMLIFrameElement | null;
    const spinner = document.getElementById('reel-loading-spinner');
    const modalTitle = document.getElementById('reel-modal-title');
    const modalDest = document.getElementById('reel-modal-dest');
    const modalViews = document.getElementById('reel-modal-views');
    const modalLikes = document.getElementById('reel-modal-likes');
    const fbLink = document.getElementById('reel-modal-fb-link') as HTMLAnchorElement | null;

    if (!track) return;

    // 1. Horizontal Carousel Smooth Arrow Navigation
    if (prevBtn && nextBtn) {
      const scrollStep = 300;
      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -scrollStep, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: scrollStep, behavior: 'smooth' });
      });
    }

    // 2. Desktop Mouse Drag to Scroll
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;
    let hasMoved = false;

    track.addEventListener('mousedown', (e) => {
      isDown = true;
      hasMoved = false;
      track.classList.add('is-dragging');
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
    });

    track.addEventListener('mouseleave', () => {
      isDown = false;
      track.classList.remove('is-dragging');
    });

    track.addEventListener('mouseup', () => {
      isDown = false;
      setTimeout(() => {
        track.classList.remove('is-dragging');
      }, 50);
    });

    track.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.5;
      if (Math.abs(walk) > 5) {
        hasMoved = true;
      }
      track.scrollLeft = scrollLeft - walk;
    });

    // 3. In-Site Original Facebook Reel Player Modal Interactions
    const reelCards = document.querySelectorAll<HTMLElement>('.reel-card');
    reelCards.forEach((card) => {
      card.addEventListener('click', (e) => {
        if (hasMoved) return; // Ignore drag clicks
        e.preventDefault();

        const title = card.dataset.title || '';
        const destination = card.dataset.destination || '';
        const fbUrl = card.dataset.fbUrl || 'https://www.facebook.com/share/1EwxdAGZvd/';
        const views = card.dataset.views || '';
        const likes = card.dataset.likes || '';

        if (modalTitle) modalTitle.textContent = title;
        if (modalDest) modalDest.textContent = destination;
        if (modalViews) modalViews.innerHTML = `<span>👁️ ${views} views</span>`;
        if (modalLikes) modalLikes.innerHTML = `<span>❤️ ${likes} likes</span>`;
        if (fbLink) fbLink.href = fbUrl;

        // Construct Facebook's Official Video / Reel Embed URL
        const embedUrl = `https://www.facebook.com/plugins/video.php?height=476&href=${encodeURIComponent(fbUrl)}&show_text=false&width=267&autoplay=true&t=0`;

        if (spinner) spinner.style.display = 'flex';

        if (fbIframe) {
          fbIframe.src = embedUrl;
          fbIframe.onload = () => {
            if (spinner) spinner.style.display = 'none';
          };
        }

        if (modal) {
          modal.setAttribute('aria-hidden', 'false');
          modal.classList.add('active');
          document.body.style.overflow = 'hidden';
        }
      });

      // Accessible keyboard enter trigger
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          card.click();
        }
      });
    });

    function closeModal() {
      if (modal) {
        modal.setAttribute('aria-hidden', 'true');
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }
      // Stop Facebook video playback and release memory
      if (fbIframe) {
        fbIframe.src = '';
      }
      if (spinner) {
        spinner.style.display = 'flex';
      }
    }

    if (modalClose) {
      modalClose.addEventListener('click', closeModal);
    }

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.classList.contains('active')) {
        closeModal();
      }
    });
  }

  document.addEventListener('astro:page-load', initFacebookReels);
  initFacebookReels();
</script>

<style>
  .fb-reels-section {
    background: linear-gradient(180deg, #f8fafc 0%, #eef2f6 100%);
    padding: 70px 0 80px;
    position: relative;
    overflow: hidden;
  }

  /* Header */
  .fb-header-wrap {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
    gap: 24px;
    flex-wrap: wrap;
  }

  .fb-badge-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .fb-icon-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #e7f3ff;
    color: #1877f2;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.3px;
  }

  .fb-svg {
    fill: #1877f2;
  }

  .fb-live-dot {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: #059669;
    font-weight: 600;
    background: #ecfdf5;
    padding: 6px 12px;
    border-radius: 20px;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: pulse-green 1.8s infinite;
  }

  @keyframes pulse-green {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 6px rgba(16, 185, 129, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
    }
  }

  .fb-section-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--c-primary, #0d2847);
    line-height: 1.25;
    margin-bottom: 8px;
  }

  .fb-section-desc {
    color: var(--c-text-light, #4b5563);
    font-size: 1.05rem;
    max-width: 620px;
    line-height: 1.5;
    margin: 0;
  }

  .fb-header-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .btn-fb-follow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1877f2;
    color: #ffffff !important;
    padding: 12px 22px;
    border-radius: 30px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(24, 119, 242, 0.35);
    transition: all 0.25s ease;
  }

  .btn-fb-follow:hover {
    background: #0d65d9;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(24, 119, 242, 0.45);
  }

  .carousel-nav-btns {
    display: flex;
    gap: 8px;
  }

  .nav-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid #d1d5db;
    background: #ffffff;
    color: #1f2937;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
  }

  .nav-btn:hover {
    background: var(--c-primary, #0d2847);
    color: #ffffff;
    border-color: var(--c-primary, #0d2847);
    transform: scale(1.05);
  }

  /* Carousel Track */
  .fb-carousel-container {
    position: relative;
    width: 100%;
  }

  .fb-reels-track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 12px 4px 20px;
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
    cursor: grab;
    -webkit-overflow-scrolling: touch;
  }

  .fb-reels-track.is-dragging {
    cursor: grabbing;
    user-select: none;
    scroll-snap-type: none;
  }

  .fb-reels-track::-webkit-scrollbar {
    height: 6px;
  }

  .fb-reels-track::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 10px;
  }

  /* Reel Card (9:16 Aspect Ratio) */
  .reel-card {
    flex: 0 0 240px;
    width: 240px;
    height: 420px;
    scroll-snap-align: start;
    border-radius: 18px;
    overflow: hidden;
    position: relative;
    background: #111827;
    cursor: pointer;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
  }

  .reel-card:hover, .reel-card:focus {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 16px 36px rgba(24, 119, 242, 0.3);
  }

  .reel-card-inner {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 16px;
  }

  .reel-poster {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .reel-card:hover .reel-poster {
    transform: scale(1.08);
  }

  .reel-overlay-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0) 35%, rgba(0, 0, 0, 0.2) 60%, rgba(0, 0, 0, 0.92) 100%);
    pointer-events: none;
  }

  /* Top tags */
  .reel-top-bar {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .reel-dest-pill {
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 12px;
    letter-spacing: 0.3px;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .reel-fb-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #1877f2;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 10px;
  }

  /* Center Play Icon */
  .reel-center-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    pointer-events: none;
  }

  .play-circle {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: #1877f2;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(24, 119, 242, 0.7);
    transition: transform 0.3s ease;
  }

  .reel-card:hover .play-circle {
    transform: scale(1.15);
  }

  .watch-hint {
    background: rgba(0, 0, 0, 0.75);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 12px;
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  /* Bottom Content */
  .reel-bottom-bar {
    position: relative;
    z-index: 2;
  }

  .reel-title {
    color: #ffffff;
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 8px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
  }

  .reel-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    color: #d1d5db;
  }

  .reel-stat {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .reel-duration {
    background: rgba(0, 0, 0, 0.7);
    padding: 2px 6px;
    border-radius: 6px;
    font-weight: 600;
    color: #fbbf24;
  }

  .swipe-hint-bar {
    text-align: center;
    font-size: 0.82rem;
    color: #6b7280;
    margin-top: 14px;
  }

  .mobile-only {
    display: none;
  }

  @media (max-width: 768px) {
    .mobile-only {
      display: block;
    }
    .carousel-nav-btns {
      display: none;
    }
    .fb-section-title {
      font-size: 1.7rem;
    }
    .reel-card {
      flex: 0 0 210px;
      width: 210px;
      height: 380px;
    }
  }

  /* In-Site Reel Modal Player */
  .reel-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(10px);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    padding: 20px;
  }

  .reel-modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .reel-modal-dialog {
    position: relative;
    width: 100%;
    max-width: 420px;
    height: 90vh;
    max-height: 740px;
    background: #000000;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.15);
    display: flex;
    flex-direction: column;
  }

