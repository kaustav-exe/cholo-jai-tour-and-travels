---
/* IntroVideo.astro - First-load video hook component with Bengali CTA and smooth curtain reveal */
---

<div id="intro-hook-container" class="intro-container">
  <video id="intro-hook-video" class="intro-video" playsinline webkit-playsinline preload="auto" loop autoplay>
    <source src="/cholo-jai-tours-and-travels-hook.mp4" type="video/mp4" />
  </video>

  <div class="intro-overlay"></div>

  <!-- Bengali Natural CTA Button (No AI Slop, No AI Gradient) -->
  <div class="intro-cta-wrapper">
    <button id="intro-enter-btn" class="intro-cta-btn" type="button" aria-label="চলুন ঘুরে আসা যাক">
      <span class="cta-text">চলুন ঘুরে আসা যাক</span>
      <svg class="cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </button>
  </div>
</div>

<style>
  .intro-container {
    position: fixed;
    inset: 0;
    z-index: 999999;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    will-change: transform, opacity;
    transition: transform 0.75s cubic-bezier(0.77, 0, 0.175, 1), opacity 0.75s cubic-bezier(0.77, 0, 0.175, 1);
  }

  /* Smooth Curtain Lift Reveal Animation */
  .intro-container.is-revealing {
    transform: translateY(-100%);
    opacity: 0.95;
    pointer-events: none;
  }

  .intro-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .intro-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.75) 0%,
      rgba(0, 0, 0, 0.2) 40%,
      rgba(0, 0, 0, 0.3) 100%
    );
    pointer-events: none;
  }

  /* CTA Wrapper & Clean Natural Solid Button (NO AI Gradient, NO AI Glow) */
  .intro-cta-wrapper {
    position: absolute;
    bottom: calc(clamp(32px, 8vh, 70px) + env(safe-area-inset-bottom, 0px));
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    width: auto;
    max-width: calc(100vw - 40px);
    text-align: center;
  }

  .intro-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 15px 36px;
    background-color: #003B73; /* Solid Ocean Blue */
    color: #FFFFFF;
    font-family: 'Hind Siliguri', 'Poppins', sans-serif;
    font-size: clamp(1.15rem, 2.4vw, 1.35rem);
    font-weight: 600;
    border-radius: 8px;
    border: 1px solid #002347;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
    cursor: pointer;
    transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
    white-space: nowrap;
    outline: none;
  }

  .intro-cta-btn:hover, .intro-cta-btn:focus-visible {
    background-color: #E05510; /* Solid Warm Accent Orange */
    border-color: #c44607;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45);
  }

  .intro-cta-btn:active {
    transform: translateY(0);
  }

  .cta-text {
    line-height: 1.2;
  }

  .cta-arrow {
    width: 22px;
    height: 22px;
    transition: transform 0.25s ease;
  }

  .intro-cta-btn:hover .cta-arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-container {
      transition: opacity 0.4s ease;
    }
    .intro-container.is-revealing {
      transform: none;
      opacity: 0;
    }
  }

  @media (max-width: 480px) {
    .intro-cta-btn {
      padding: 13px 26px;
      font-size: 1.05rem;
    }
  }
</style>

<script>
  function initIntroHook() {
    const container = document.getElementById('intro-hook-container');
    const video = document.getElementById('intro-hook-video') as HTMLVideoElement | null;
    const enterBtn = document.getElementById('intro-enter-btn');

    if (!container || !video) return;

    // Check if user already completed intro in this session
    try {
      if (sessionStorage.getItem('cholo_jai_intro_seen') === '1') {
        container.style.display = 'none';
        document.documentElement.classList.add('intro-done');
        return;
      }
    } catch (e) {}

    // Default audio ON per client instructions
    video.muted = false;
    video.volume = 1.0;

    const playPromise = video.play();
    if (playPromise !== undefined) {
      playPromise.catch(() => {
        // If browser blocks unmuted autoplay, start muted and unmute immediately on user touch/click anywhere
        video.muted = true;
        video.play().catch(() => {});

        const unmuteOnInteraction = () => {
          video.muted = false;
          ['click', 'touchstart', 'keydown'].forEach(ev => {
            window.removeEventListener(ev, unmuteOnInteraction);
          });
        };

        ['click', 'touchstart', 'keydown'].forEach(ev => {
          window.addEventListener(ev, unmuteOnInteraction, { once: true, passive: true });
        });
      });
    }

    // Reveal transition function
    let isRevealing = false;
    function revealWebsite() {
      if (isRevealing) return;
      isRevealing = true;

      // 1. Play the smooth curtain lift animation FIRST
      container?.classList.add('is-revealing');

      // 2. Smoothly fade audio volume
      const fadeInterval = setInterval(() => {
        if (video && video.volume > 0.1) {
          video.volume = Math.max(0, video.volume - 0.15);
        } else {
          clearInterval(fadeInterval);
          if (video) video.pause();
        }
      }, 50);

      // 3. ONLY after 750ms animation finishes, set session flag and hide container
      setTimeout(() => {
        try {
          sessionStorage.setItem('cholo_jai_intro_seen', '1');
        } catch (e) {}
        document.documentElement.classList.add('intro-done');
        if (container) container.style.display = 'none';
      }, 750);
    }

    enterBtn?.addEventListener('click', revealWebsite);
  }

  document.addEventListener('astro:page-load', initIntroHook);
  initIntroHook();
</script>
