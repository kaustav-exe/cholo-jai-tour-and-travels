---
/* IntroVideo.astro - First-load video hook component with Bengali CTA and smooth curtain reveal */
---

<div id="intro-hook-container" class="intro-container">
  <video id="intro-hook-video" class="intro-video" playsinline webkit-playsinline preload="auto" loop autoplay>
    <source src="/cholo-jai-tours-and-travels-hook.mp4" type="video/mp4" />
  </video>

  <div class="intro-overlay"></div>

  <!-- Bengali Natural CTA Button (Wider, Premium, No Arrow Icon) -->
  <div class="intro-cta-wrapper">
    <button id="intro-enter-btn" class="intro-cta-btn" type="button" aria-label="চলুন ঘুরে আসা যাক">
      <span class="cta-text">চলুন ঘুরে আসা যাক</span>
    </button>
  </div>
</div>

<style>
  .intro-container {
    position: fixed;
    inset: 0;
    z-index: 999999;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    will-change: transform, opacity;
    transition: transform 0.75s cubic-bezier(0.77, 0, 0.175, 1), opacity 0.75s cubic-bezier(0.77, 0, 0.175, 1);
  }

  /* Smooth Curtain Lift Reveal Animation */
  .intro-container.is-revealing {
    transform: translateY(-100%);
    opacity: 0.95;
    pointer-events: none;
  }

  .intro-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .intro-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.75) 0%,
      rgba(0, 0, 0, 0.2) 40%,
      rgba(0, 0, 0, 0.3) 100%
    );
    pointer-events: none;
  }

  /* CTA Wrapper & Wider Premium Natural Button (No Arrow Icon, No AI Slop) */
  .intro-cta-wrapper {
    position: absolute;
    bottom: calc(clamp(36px, 9vh, 75px) + env(safe-area-inset-bottom, 0px));
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    width: auto;
    max-width: calc(100vw - 32px);
    text-align: center;
  }

  .intro-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: clamp(280px, 50vw, 420px);
    padding: 18px 56px;
    background-color: #003B73; /* Solid Ocean Blue */
    color: #FFFFFF;
    font-family: 'Hind Siliguri', 'Poppins', sans-serif;
    font-size: clamp(1.25rem, 2.8vw, 1.5rem);
    font-weight: 700;
    letter-spacing: 0.5px;
    border-radius: 10px;
    border: 1.5px solid rgba(255, 255, 255, 0.45);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    cursor: pointer;
    transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
    white-space: nowrap;
    outline: none;
  }

  .intro-cta-btn:hover, .intro-cta-btn:focus-visible {
    background-color: #E05510; /* Solid Warm Accent Orange */
    border-color: #ffffff;
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.55);
  }

  .intro-cta-btn:active {
    transform: translateY(0) scale(0.99);
  }

  .cta-text {
    line-height: 1.25;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-container {
      transition: opacity 0.4s ease;
    }
    .intro-container.is-revealing {
      transform: none;
      opacity: 0;
    }
  }

  @media (max-width: 480px) {
    .intro-cta-btn {
      min-width: calc(100vw - 48px);
      padding: 16px 32px;
      font-size: 1.15rem;
    }
  }
</style>

<script>
  function initIntroHook() {
    const container = document.getElementById('intro-hook-container');
    const video = document.getElementById('intro-hook-video') as HTMLVideoElement | null;
    const enterBtn = document.getElementById('intro-enter-btn');

    if (!container || !video) return;

    // Check if user already completed intro in this session
    try {
      if (sessionStorage.getItem('cholo_jai_intro_seen') === '1') {
        video.pause();
        video.muted = true;
        video.removeAttribute('src');
        video.load();
        container.style.display = 'none';
        container.remove();
        document.documentElement.classList.add('intro-done');
        return;
      }
    } catch (e) {}

    // Default audio ON per client instructions
    video.muted = false;
    video.volume = 1.0;

    const playPromise = video.play();
    if (playPromise !== undefined) {
      playPromise.catch(() => {
        // If browser blocks unmuted autoplay, start muted and unmute immediately on user touch/click anywhere
        video.muted = true;
        video.play().catch(() => {});

        const unmuteOnInteraction = () => {
          if (video) video.muted = false;
          ['click', 'touchstart', 'keydown'].forEach(ev => {
            window.removeEventListener(ev, unmuteOnInteraction);
          });
        };

        ['click', 'touchstart', 'keydown'].forEach(ev => {
          window.addEventListener(ev, unmuteOnInteraction, { once: true, passive: true });
        });
      });
    }

    // Reveal transition function
    let isRevealing = false;
    function revealWebsite() {
      if (isRevealing) return;
      isRevealing = true;

      // 1. IMMEDIATELY pause and unload video audio pipeline
      if (video) {
        video.pause();
        video.muted = true;
        video.currentTime = 0;
        video.removeAttribute('src');
        video.load();
      }

      // 2. Play the smooth curtain lift animation FIRST
      container?.classList.add('is-revealing');

      // 3. AFTER 750ms curtain lift animation, set session flag, hide & unmount container node completely
      setTimeout(() => {
        try {
          sessionStorage.setItem('cholo_jai_intro_seen', '1');
        } catch (e) {}
        document.documentElement.classList.add('intro-done');
        if (container) {
          container.style.display = 'none';
          container.remove(); // Completely unmount element from DOM
        }
      }, 750);
    }

    enterBtn?.addEventListener('click', revealWebsite);
  }

  document.addEventListener('astro:page-load', initIntroHook);
  initIntroHook();
</script>
