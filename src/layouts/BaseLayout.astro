---
import { siteConfig } from '../data/siteConfig';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SubtabDrawer from '../components/SubtabDrawer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const { 
  title = `${siteConfig.name} - Premium Travel Experiences`, 
  description = "Discover the world with Cholo Jai Tour & Travels. We offer premium, curated travel packages for an unforgettable experience." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/icon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={Astro.url} />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content="/images/tour-1.jpeg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/images/tour-1.jpeg" />

    <!-- Preconnect & Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" />

    <!-- Instant Session Check for Intro Video -->
    <script is:inline>
      try {
        if (sessionStorage.getItem('cholo_jai_intro_seen') === '1') {
          document.documentElement.classList.add('intro-done');
        }
      } catch (e) {}
    </script>

    <!-- Client-side SPA navigation -->
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main style="overflow-x:hidden;min-width:0;width:100%;">
      <slot />
    </main>
    <Footer />

    <!-- In-Page Subtab Drawer Component -->
    <SubtabDrawer />
  </body>
</html>
