<script>
  /* ─── Meal Badges ───────────────────────────────────────────── */
  function renderMeals() {
    document.querySelectorAll<HTMLElement>('.t-meals[data-meals]').forEach(el => {
      const text = el.dataset.meals || '';
      if (!text) return;
      el.innerHTML = `<span class="t-meal-pill">${text}</span>`;
    });
  }

  /* ─── Roadmap Animation & Smooth 60fps Lerp Bus Icon ───────── */
  function initRoadmap() {
    const lineTrack = document.querySelector<HTMLElement>('.t-track__line');
    const lineFill  = document.getElementById('t-line-fill');
    const beacon    = document.getElementById('t-bus-beacon');
    const nodes     = document.querySelectorAll('.t-node');

    if (!lineTrack || !lineFill) return;

    let currentPct = 0;
    let targetPct = 0;

    function updateTarget() {
      const rect = lineTrack.getBoundingClientRect();
      const windowH = window.innerHeight;
      const start = windowH * 0.75;
      const current = start - rect.top;
      const total = rect.height;
      targetPct = Math.min(Math.max((current / total) * 100, 0), 100);
    }

    function animLoop() {
      currentPct += (targetPct - currentPct) * 0.12;
      lineFill.style.height = `${currentPct.toFixed(2)}%`;
      if (beacon) {
        beacon.style.top = `${currentPct.toFixed(2)}%`;
      }
      requestAnimationFrame(animLoop);
    }

    window.addEventListener('scroll', updateTarget, { passive: true });
    updateTarget();
    requestAnimationFrame(animLoop);

    const nodeIO = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

    nodes.forEach(n => nodeIO.observe(n));
  }

  /* ─── Auto-sliding sticky nav ──────────────────────────────── */
  function initStickyNav() {
    const navRow  = document.getElementById('t-snav-row');
    const links   = document.querySelectorAll<HTMLAnchorElement>('.t-sn[data-section]');
    const sections = Array.from(links).map(l => document.getElementById(l.dataset.section!)).filter(Boolean) as HTMLElement[];
    if (!navRow || !links.length || !sections.length) return;

    function setActive(id: string) {
      links.forEach(l => l.classList.toggle('is-active', l.dataset.section === id));
      const activeLink = navRow.querySelector<HTMLElement>('.t-sn.is-active');
      if (activeLink) {
        const rowRect = navRow.getBoundingClientRect();
        const linkRect = activeLink.getBoundingClientRect();
        const offset = linkRect.left - rowRect.left - (rowRect.width / 2) + (linkRect.width / 2);
        navRow.scrollBy({ left: offset, behavior: 'smooth' });
      }
    }

    if (sections[0]) setActive(sections[0].id);

    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) setActive((e.target as HTMLElement).id);
      });
    }, { rootMargin: '-30% 0px -60% 0px', threshold: 0 });

    sections.forEach(s => io.observe(s));
  }

  /* ─── Interactive Month Selector for Seasonal Pricing ──────── */
  function initSeasonalMonthSelector() {
    const monthCards = document.querySelectorAll<HTMLButtonElement>('.sp-month-card');
    const activePriceVal = document.getElementById('active-price-val');
    const activeMonthLabel = document.getElementById('active-month-label');
    const heroActiveBadge = document.querySelector('.hero-active-month-badge');
    const heroWaBtn = document.getElementById('hero-wa-btn') as HTMLAnchorElement | null;
    const tariffVal = document.querySelector('.t-pstrip__val');
    const sidebarPrice = document.querySelector('.t-sb__price');

    if (!monthCards.length) return;

    const pkgTitle = document.querySelector('.t-hero__h1')?.textContent?.trim() || 'Tour Package';

    monthCards.forEach(card => {
      card.addEventListener('click', () => {
        monthCards.forEach(c => c.classList.remove('active'));
        card.classList.add('active');

        const month = card.dataset.month || 'Current';
        const price = parseInt(card.dataset.price || '0', 10);
        const formattedPrice = card.dataset.formattedPrice || `₹${price.toLocaleString('en-IN')}`;

        if (activePriceVal) activePriceVal.textContent = formattedPrice;
        if (activeMonthLabel) activeMonthLabel.textContent = month;
        if (heroActiveBadge) heroActiveBadge.textContent = `📅 ${month} Departure Fare 🔥`;
        if (tariffVal) tariffVal.textContent = `${formattedPrice} / person (${month})`;
        if (sidebarPrice) sidebarPrice.innerHTML = `${formattedPrice} <span class="t-sb__pp">/ person</span>`;

        // Update WhatsApp link context
        if (heroWaBtn) {
          const msg = `Hello Cholo Jai Tour & Travels, I am interested in the ${pkgTitle} package for ${month} departure (${formattedPrice}/person). Please share availability and booking details.`;
          heroWaBtn.href = `https://wa.me/919830905332?text=${encodeURIComponent(msg)}`;
        }

        // Trigger recalculation of total estimate
        const gInput = document.getElementById('t-guests') as HTMLInputElement | null;
        if (gInput) {
          gInput.dispatchEvent(new Event('input'));
        }
      });
    });
  }

  /* ─── Estimator ────────────────────────────────────────────── */
  function initEstimator() {
    const gInput = document.getElementById('t-guests') as HTMLInputElement | null;
    const estEl  = document.getElementById('t-est');

    function update() {
      if (!gInput || !estEl) return;
      const priceEl = document.getElementById('active-price-val');
      const base = parseInt((priceEl?.textContent || '').replace(/[^0-9]/g, '')) || 15000;
      const c = Math.max(1, parseInt(gInput.value) || 1);
      const total = base * c;
      estEl.textContent = `₹${base.toLocaleString('en-IN')} × ${c} = ₹${total.toLocaleString('en-IN')}`;
    }

    gInput?.addEventListener('input', update);
    update();
  }

  /* ─── Form ─────────────────────────────────────────────────── */
  function initForm() {
    const form = document.getElementById('t-book-form') as HTMLFormElement | null;

    form?.addEventListener('submit', e => {
      e.preventDefault();
      const fd = new FormData(form);
      const priceEl = document.getElementById('active-price-val');
      const base = parseInt((priceEl?.textContent || '').replace(/[^0-9]/g, '')) || 15000;
      const guests = parseInt(fd.get('guests') as string || '1') || 1;
      const total = base * guests;
      const activeMonth = document.getElementById('active-month-label')?.textContent || '';

      const txt = encodeURIComponent(
        `Hello Cholo Jai Tour & Travels!\n\n`+
        `Package: ${fd.get('package_name')}\n`+
        `Departure Month: ${activeMonth}\n`+
        `Rate per person: ₹${base.toLocaleString('en-IN')}\n`+
        `Name: ${fd.get('name')}\n`+
        `Phone: ${fd.get('phone')}\n`+
        `Travel Date: ${fd.get('date')}\n`+
        `Passengers: ${guests}\n`+
        `Hotel Type: ${fd.get('hotel')}\n`+
        `Estimated Total: ₹${total.toLocaleString('en-IN')}\n\n`+
        `Please confirm availability!`
      );
      window.open(`https://wa.me/919830905332?text=${txt}`, '_blank');
    });
  }

  /* ─── Collapsible Section Toggles ─────────────────────────── */
  function initCollapsibleToggles() {
    document.querySelectorAll<HTMLElement>('.t-card__head--toggle').forEach(head => {
      head.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        const card = head.closest('.t-card');
        const body = card?.querySelector<HTMLElement>('.t-collapsible-body');
        if (!card || !body) return;

        const isExpanded = card.classList.contains('is-expanded');
        if (isExpanded) {
          card.classList.remove('is-expanded');
          body.style.maxHeight = '52px';
        } else {
          card.classList.add('is-expanded');
          body.style.maxHeight = '1500px';
        }
      };
    });
  }

  function boot() {
    renderMeals();
    initRoadmap();
    initStickyNav();
    initCollapsibleToggles();
    initSeasonalMonthSelector();
    initEstimator();
    initForm();
  }
  document.addEventListener('astro:page-load', boot);
  boot();
</script>
