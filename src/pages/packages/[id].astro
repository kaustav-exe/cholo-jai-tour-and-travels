---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { TourPackage } from '../../data/packages';
import { ContentService } from '../../services/content/contentService';
import { 
  getPackagePriceForMonth, 
  getSeasonalMonthlyBreakdown, 
  getWhatsAppBookingUrl, 
  getCurrentMonthName,
  formatCurrency
} from '../../utils/pricing';
import { 
  MapPin, Clock, Star, Calendar, CheckCircle, XCircle, Bus, Hotel, 
  CreditCard, PhoneCall, ChevronRight, ChevronDown, Sparkles, Compass, 
  MessageSquare, Camera, Play, Video, Send, Tag, Info
} from 'lucide-astro';

export async function getStaticPaths() {
  const allPackages = await ContentService.getAllPackages();
  return allPackages.map((pkg) => ({
    params: { id: pkg.id },
    props: { pkg },
  }));
}

const { id } = Astro.params;
const pkg = ((Astro.props as any).pkg as TourPackage) || (id ? await ContentService.getPackageById(id) : undefined);

if (!pkg) {
  return Astro.redirect('/packages');
}

const rating = pkg.rating || 4.8;
const reviews = pkg.reviewsCount || 100;
const highlights = pkg.highlights || ["Guided sightseeing", "Private vehicle transfers", "Deluxe accommodation", "Daily breakfast"];
const galleryPhotos = pkg.gallery || [pkg.image];

// Seasonal pricing calculations
const currentMonth = getCurrentMonthName();
const initialPricing = getPackagePriceForMonth(pkg);
const monthlyBreakdown = getSeasonalMonthlyBreakdown(pkg);
const initialWaUrl = getWhatsAppBookingUrl(pkg.title, currentMonth, initialPricing.formattedPrice);
---

<BaseLayout title={`${pkg.title} (${pkg.duration}) | Cholo Jai Tour & Travels`}>

  <!-- ═══ HERO ═══════════════════════════════════════════════════════ -->
  <header class="t-hero">
    <div class="t-hero__bg" style={`background-image:url('${pkg.image}')`}></div>
    <div class="t-hero__overlay"></div>
    <div class="t-inner">
      <nav class="t-crumb">
        <a href="/">Home</a><ChevronRight size={11}/><a href="/packages">Packages</a><ChevronRight size={11}/><span>{pkg.title}</span>
      </nav>
      <div class="t-hero__body">
        <div class="t-hero__text">
          <div class="t-tags">
            <span class="t-tag t-tag--loc"><MapPin size={11}/> {pkg.destination}</span>
            <span class="t-tag t-tag--dur"><Clock size={11}/> {pkg.duration}</span>
            <span class="t-tag t-tag--star"><Star size={11} fill="#F59E0B" color="#F59E0B"/> {rating} ({reviews})</span>
            <span class="t-tag t-tag--date hero-active-month-badge"><Calendar size={11}/> {initialPricing.periodLabel} 🔥</span>
          </div>
          <h1 class="t-hero__h1">{pkg.title}</h1>
          {pkg.stayBreakdown && (
            <p class="t-hero__stay-breakdown">
              <strong>Stay:</strong> {pkg.stayBreakdown}
            </p>
          )}
          <p class="t-hero__sub">{pkg.shortDescription}</p>
        </div>

        <!-- Price Card -->
        <div class="t-pcard">
          <div class="t-batch-highlight">
            <Calendar size={12} class="tb-ico" />
            <span>Active Month: <strong id="active-month-label">{currentMonth}</strong></span>
            <span class="tb-badge">Dynamic Fare</span>
          </div>
          <p class="t-pcard__lbl" id="price-card-label">Applicable Rate per person</p>
          <div class="t-pcard__row">
            <span class="t-pcard__price" id="active-price-val">{initialPricing.formattedPrice}</span>
            {pkg.pricingDetails?.originalPrice && <span class="t-pcard__old">{pkg.pricingDetails.originalPrice}</span>}
          </div>
          <div class="t-pcard__btns">
            <a href="#booking-form" class="t-btn t-btn--orange">Book Online</a>
            <a href={initialWaUrl} id="hero-wa-btn" target="_blank" rel="noopener" class="t-btn t-btn--wa">
              <MessageSquare size={12}/> WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ═══ STICKY NAV ══════════════════════════════════════════════════ -->
  <nav class="t-snav" id="t-snav">
    <div class="t-inner t-snav__row" id="t-snav-row">
      <a href="#overview"          class="t-sn" data-section="overview">Highlights</a>
      <a href="#seasonal-pricing" class="t-sn" data-section="seasonal-pricing">Seasonal Rates</a>
      <a href="#gallery"           class="t-sn" data-section="gallery">Gallery</a>
      <a href="#journey"           class="t-sn" data-section="journey">Journey</a>
      <a href="#stay"              class="t-sn" data-section="stay">Stay &amp; Cab</a>
      <a href="#pricing"           class="t-sn" data-section="pricing">Tariff</a>
      <a href="#booking-form"      class="t-sn t-sn--cta" data-section="booking-form">Book Now</a>
    </div>
  </nav>

  <!-- ═══ PAGE BODY ════════════════════════════════════════════════ -->
  <div class="t-inner t-page">
    <div class="t-layout">

      <!-- ── MAIN COL ─────────────────────────────────────────── -->
      <main class="t-main">

        <!-- HIGHLIGHTS -->
        <section class="t-card t-card--toggleable" id="overview">
          <div class="t-card__head t-card__head--toggle" data-toggle="overview">
            <div class="t-card__head-title">
              <Sparkles size={15} class="t-card__ico"/>
              <h2>Highlights</h2>
            </div>
            <button class="t-card__toggle-btn" aria-label="Toggle section">
              <ChevronDown size={14} class="t-toggle-icon"/>
            </button>
          </div>
          <div class="t-collapsible-body" id="collapsible-overview">
            <div class="t-hl-grid">
              {highlights.map(h => (
                <div class="t-hl-item">
                  <CheckCircle size={13} class="t-hl-chk"/>
                  <span>{h}</span>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- SEASONAL PRICING VISUALIZATION -->
        <section class="t-card" id="seasonal-pricing">
          <div class="t-card__head">
            <Calendar size={15} class="t-card__ico"/>
            <h2>Seasonal Pricing &amp; Departure Fares</h2>
          </div>
          <p class="sp-subtext">
            Select your preferred travel month below to view applicable fares. Rates automatically update across all booking links.
          </p>

          <div class="sp-grid" id="sp-grid">
            {monthlyBreakdown.map((item) => (
              <button
                type="button"
                class={`sp-month-card ${item.isCurrentMonth ? 'active' : ''} ${item.isPeak ? 'peak' : ''}`}
                data-month={item.month}
                data-price={item.price}
                data-formatted-price={item.formattedPrice}
                title={`Click to select ${item.month} departure fare (${item.formattedPrice})`}
              >
                <span class="sp-month-name">{item.shortMonth}</span>
                <span class="sp-month-price">{item.formattedPrice}</span>
                {item.isCurrentMonth && <span class="sp-current-badge">Current Month</span>}
                {item.isPeak && !item.isCurrentMonth && <span class="sp-peak-badge">Peak Season</span>}
              </button>
            ))}
          </div>

          <div class="sp-footer-note">
            <Info size={13} class="info-ico" />
            <span>Prices may vary based on travel date, availability, and final booking confirmation.</span>
          </div>
        </section>

        <!-- GALLERY -->
        <section class="t-card t-card--toggleable" id="gallery">
          <div class="t-card__head t-card__head--toggle" data-toggle="gallery">
            <div class="t-card__head-title">
              <Camera size={15} class="t-card__ico"/>
              <h2>Gallery</h2>
            </div>
            <button class="t-card__toggle-btn" aria-label="Toggle section">
              <ChevronDown size={14} class="t-toggle-icon"/>
            </button>
          </div>
          <div class="t-collapsible-body" id="collapsible-gallery">
            <div class="t-gal">
              {galleryPhotos.map((img, i) => (
                <div class="t-gal__thumb">
                  <img src={img} alt={`${pkg.title} ${i+1}`} loading="lazy"/>
                </div>
              ))}
            </div>
            <div class="t-vstrip">
              <span class="t-vstrip__txt"><Video size={13}/> Video tour preview</span>
              <a href={`https://wa.me/919830905332?text=Send%20video%20tour%20for%20${encodeURIComponent(pkg.title)}`} target="_blank" rel="noopener" class="t-btn t-btn--sm t-btn--orange">
                <Play size={11}/> Get Video
              </a>
            </div>
          </div>
        </section>

        <!-- JOURNEY ROADMAP + SCHEDULE (merged) -->
        {pkg.itinerary && pkg.itinerary.length > 0 && (
          <section class="t-card t-journey" id="journey">
            <div class="t-card__head"><Compass size={15} class="t-card__ico"/><h2>Journey Roadmap &amp; Schedule</h2></div>

            <div class="t-track">
              <!-- Vertical connector line -->
              <div class="t-track__line" aria-hidden="true">
                <div class="t-track__line-fill" id="t-line-fill"></div>
                <!-- Moving Tour Bus Badge -->
                <div class="t-track__beacon" id="t-bus-beacon" title="Traveling...">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8 6v6M16 6v6M2 12h20M4 18v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2M17 18v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2M4 11l1.5-4.5A2 2 0 0 1 7.4 5h9.2a2 2 0 0 1 1.9 1.5L20 11M3 11h18a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-5a1 1 0 0 1 1-1z"/>
                  </svg>
                </div>
              </div>

              <!-- Start -->
              <div class="t-node t-node--start t-anim" style="--d:0ms">
                <div class="t-dot t-dot--start">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2"/></svg>
                </div>
                <div class="t-node__lbl">
                  <span class="t-node__badge">Pickup</span>
                  <p>{pkg.transport?.pickup?.split('or')[0]?.trim() || 'Pickup & Arrival'}</p>
                </div>
              </div>

              <!-- Day nodes -->
              {pkg.itinerary.map((day, idx) => (
                <div class="t-node t-node--day t-anim" style={`--d:${(idx+1)*60}ms`} data-day={day.day}>
                  <div class="t-dot t-dot--day"><span>{day.day}</span></div>
                  <div class="t-day-card" id={`day-${day.day}`}>
                    <div class="t-day-card__top">
                      <div>
                        <span class="t-day-card__label">Day {day.day}</span>
                        <h3 class="t-day-card__title">{day.title}</h3>
                      </div>
                      <div class="t-meals" data-meals={day.meals}></div>
                    </div>
                    <p class="t-day-card__desc">{day.desc}</p>
                    {day.spots && day.spots.length > 0 && (
                      <div class="t-spots">
                        {day.spots.map(s => <span class="t-spot"><MapPin size={9}/> {s}</span>)}
                      </div>
                    )}
                  </div>
                </div>
              ))}

              <!-- Finish -->
              <div class="t-node t-node--finish t-anim" style={`--d:${(pkg.itinerary.length+1)*60}ms`}>
                <div class="t-dot t-dot--finish">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <div class="t-node__lbl t-node__lbl--fin">
                  <span class="t-node__badge t-node__badge--fin">Complete</span>
                  <p>Safe return drop-off</p>
                </div>
              </div>
            </div>
          </section>
        )}

        <!-- TRANSPORT & HOTEL -->
        <section class="t-card" id="stay">
          <div class="t-card__head"><Bus size={15} class="t-card__ico"/><h2>Transport &amp; Hotel</h2></div>
          <div class="t-spec-grid">
            <div class="t-spec-box">
              <p class="t-spec-title">Transport</p>
              <p><span class="t-sl">Mode:</span> {pkg.transport?.mode || 'Flight / Train'}</p>
              <p><span class="t-sl">Pickup:</span> {pkg.transport?.pickup || 'Airport / Station'}</p>
              <p><span class="t-sl">Vehicle:</span> {pkg.transport?.vehicle || 'Private Sedan'}</p>
            </div>
            <div class="t-spec-box">
              <p class="t-spec-title">Hotel &amp; Meals</p>
              <p><span class="t-sl">Grade:</span> {pkg.accommodation?.category || '3-Star Deluxe'}</p>
              <p><span class="t-sl">Meals:</span> {pkg.accommodation?.meals || 'Breakfast & Dinner'}</p>
              <p><span class="t-sl">Stay:</span> {(pkg.accommodation?.description || 'Handpicked premium rooms').slice(0,60)}…</p>
            </div>
          </div>
        </section>

        <!-- TARIFF -->
        <section class="t-card" id="pricing">
          <div class="t-card__head"><CreditCard size={15} class="t-card__ico"/><h2>Tariff &amp; Inclusions</h2></div>

          <div class="t-pstrip">
            <div>
              <span class="t-pstrip__lbl">Package Rate</span>
              <span class="t-pstrip__val">{pkg.pricingDetails?.perHead || pkg.price + ' / person'}</span>
            </div>
            <a href="#booking-form" class="t-btn t-btn--gold">Best Price</a>
          </div>

          <div class="t-ie">
            <div class="t-ie-inc">
              <div class="t-ie-head t-ie-head--inc"><CheckCircle size={13}/><span>Included</span></div>
              <ul>
                {(pkg.pricingDetails?.inclusions || ['Private cab transfers','Deluxe hotel stay','Daily Breakfast & Dinner','Driver tolls & taxes']).map(i => <li>— {i}</li>)}
              </ul>
            </div>
            <div class="t-ie-exc">
              <div class="t-ie-head t-ie-head--exc"><XCircle size={13}/><span>Excluded</span></div>
              <ul>
                {(pkg.pricingDetails?.exclusions || ['Airfare / Train fare','Entry tickets','Personal expenses']).map(e => <li>— {e}</li>)}
              </ul>
            </div>
          </div>
        </section>

        <!-- BOOKING FORM -->
        <section class="t-card t-card--book" id="booking-form">
          <div class="t-card__head"><Send size={15} class="t-card__ico"/><h2>WhatsApp Reservation</h2></div>
          <form id="t-book-form" class="t-form">
            <input type="hidden" name="package_name" value={pkg.title}/>
            <div class="t-form__r2">
              <div class="t-fg"><label>Full Name *</label><input type="text" name="name" placeholder="Your name" required/></div>
              <div class="t-fg"><label>WhatsApp No. *</label><input type="tel" name="phone" placeholder="+91 98xxx xxxxx" required/></div>
            </div>
            <div class="t-form__r3">
              <div class="t-fg"><label>Travel Date *</label><input type="date" name="date" required/></div>
              <div class="t-fg"><label>Passengers *</label><input id="t-guests" type="number" name="guests" min="1" max="40" value="2" required/></div>
              <div class="t-fg"><label>Hotel Type</label>
                <select name="hotel"><option>3-Star Deluxe</option><option>4-Star Premium</option><option>Luxury Resort</option></select>
              </div>
            </div>
            <div class="t-estimator">
              <span>Estimated Total:</span>
              <strong id="t-est"></strong>
            </div>
            <button type="submit" class="t-submit"><Send size={13}/> Send via WhatsApp</button>
          </form>
        </section>

      </main>

      <!-- ── SIDEBAR ──────────────────────────────────────────── -->
      <aside class="t-sidebar">
        <div class="t-sb">
          <div class="t-sb__head">
            <span class="t-sb__from">Starting From</span>
            <span class="t-sb__price">{pkg.price} <span class="t-sb__pp">/ person</span></span>
          </div>
          <div class="t-sb__specs">
            <div class="t-sb__row"><span>Duration</span><strong>{pkg.duration}</strong></div>
            <div class="t-sb__row"><span>Destination</span><strong>{pkg.destination}</strong></div>
            <div class="t-sb__row"><span>Hotel</span><strong>{(pkg.accommodation?.category || '3-Star').split(' ')[0]}</strong></div>
          </div>
          <a href="#booking-form" class="t-btn t-btn--blue t-btn--full">Book Online</a>
          <a href={`https://wa.me/919830905332?text=Hi%20I%20want%20to%20book%20${encodeURIComponent(pkg.title)}`} target="_blank" rel="noopener" class="t-btn t-btn--wa t-btn--full" style="margin-top:6px">
            <MessageSquare size={12}/> WhatsApp Inquiry
          </a>
          <div class="t-sb__call">
            <PhoneCall size={12}/> Call: <strong>+91 98309 05332</strong>
          </div>
        </div>
      </aside>

    </div>
  </div>

  <!-- ═══ MOBILE BAR ═══════════════════════════════════════════ -->
  <div class="t-mobbar">
    <div class="t-mobbar__price">
      <span>From</span>
      <strong>{pkg.price}</strong>
    </div>
    <a href="#booking-form" class="t-btn t-btn--blue">Book Now</a>
  </div>

</BaseLayout>

<style>
/* ══════════════════════════════════════════════════════════════
   RESET & SCOPE — keep all detail-page styles tightly scoped
══════════════════════════════════════════════════════════════ */
.t-inner {
  width: 100%;
  max-width: 1100px;
  margin-inline: auto;
  padding-inline: 16px;
}

/* ══════════════════════════════════════════════════════════════
   HERO
══════════════════════════════════════════════════════════════ */
.t-hero {
  position: relative;
  min-height: 280px;
  display: flex;
  align-items: flex-end;
  padding-top: 40px;
  padding-bottom: 24px;
  overflow: hidden;
}
.t-hero__bg {
  position: absolute; inset: 0;
  background-size: cover; background-position: center;
}
.t-hero__overlay {
  position: absolute; inset: 0;
  background: linear-gradient(175deg, rgba(0,20,40,.3) 0%, rgba(0,25,55,.9) 100%);
}
.t-hero > .t-inner { position: relative; z-index: 2; }

.t-crumb {
  display: flex; align-items: center; gap: 4px;
  font-size: .73rem; color: rgba(255,255,255,.75); margin-bottom: 10px;
}
.t-crumb a { color: #FFD166; text-decoration: none; }
.t-crumb a:hover { text-decoration: underline; }

.t-hero__body {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 12px;
  flex-wrap: wrap;
}
.t-hero__text { flex: 1; min-width: 200px; max-width: 580px; }
@media (max-width: 600px) {
  .t-hero__body { flex-direction: column; align-items: stretch; }
  .t-pcard { max-width: 100% !important; min-width: 0 !important; width: 100%; }
  .t-pcard__btns { display: grid; grid-template-columns: 1fr 1fr; }
  .t-btn { justify-content: center; }
  .t-hero { min-height: auto; padding-bottom: 16px; }
}

/* Pills */
.t-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 7px; }
.t-tag {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 3px 9px; border-radius: 10px;
  font-size: .72rem; font-weight: 600; line-height: 1;
  white-space: nowrap; flex-shrink: 0;
}
.t-tag svg { width: 11px !important; height: 11px !important; flex-shrink: 0; display: block; }
.t-tag--loc { background: rgba(255,255,255,.18); color: #fff; }
.t-tag--dur { background: #F26419; color: #fff; }
.t-tag--star { background: #fff; color: #1E293B; box-shadow: 0 1px 4px rgba(0,0,0,0.1); }
.t-tag--date {
  background: linear-gradient(135deg, #F26419, #e05510);
  color: #fff;
  font-weight: 700;
  box-shadow: 0 2px 8px rgba(242,100,25,0.35);
}

.t-batch-highlight {
  background: #FFF7ED;
  border: 1px solid #FFEDD5;
  border-radius: 8px;
  padding: 5px 8px;
  margin-bottom: 8px;
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: .73rem;
  color: #9A3412;
  font-weight: 600;
}
.tb-badge {
  margin-left: auto;
  background: #F26419;
  color: #fff;
  font-size: .62rem;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 10px;
}

.t-hero__h1 {
  font-size: clamp(1.35rem, 3vw, 2rem);
  font-weight: 800; color: #fff;
  line-height: 1.25; margin-bottom: 5px;
}
.t-hero__sub {
  font-size: .84rem; color: rgba(255,255,255,.85); line-height: 1.5;
}

/* Price Card */
.t-pcard {
  background: #fff; border-radius: 12px;
  padding: 12px 14px; min-width: 210px; max-width: 260px;
  box-shadow: 0 6px 24px rgba(0,0,0,.2);
  flex-shrink: 0;
}
.t-pcard__lbl { font-size: .68rem; text-transform: uppercase; color: #64748B; font-weight: 600; }
.t-pcard__row { display: flex; align-items: baseline; gap: 6px; margin: 2px 0 10px; }
.t-pcard__price { font-size: 1.35rem; font-weight: 800; color: #F26419; font-family: var(--f-heading); }
.t-pcard__old { font-size: .76rem; text-decoration: line-through; color: #94A3B8; }
.t-pcard__btns { display: flex; gap: 6px; }

/* ── Buttons (fixed compact sizes — no .btn inheritance) ── */
.t-btn {
  display: inline-flex; align-items: center; justify-content: center;
  gap: 4px; font-size: .78rem; font-weight: 700;
  padding: 0 12px; height: 30px; border-radius: 7px;
  text-decoration: none; white-space: nowrap;
  border: none; cursor: pointer; line-height: 1;
  font-family: var(--f-heading);
  transition: filter .2s, transform .15s;
}
.t-btn:hover { filter: brightness(1.08); transform: translateY(-1px); }
.t-btn:active { transform: translateY(0); }
.t-btn--orange { background: #F26419; color: #fff; }
.t-btn--wa    { background: #25D366; color: #fff; }
.t-btn--blue  { background: #003B73; color: #fff; }
.t-btn--gold  { background: #FFD166; color: #003B73; }
.t-btn--sm    { height: 26px; font-size: .72rem; padding: 0 10px; border-radius: 5px; }
.t-btn--full  { width: 100%; }
.t-btn svg    { width: 12px; height: 12px; flex-shrink: 0; }

/* ══════════════════════════════════════════════════════════════
   STICKY NAV — auto-sliding active highlight
══════════════════════════════════════════════════════════════ */
.t-snav {
  position: sticky; top: 0; z-index: 100;
  background: #fff;
  border-bottom: 1px solid #E2E8F0;
  box-shadow: 0 1px 6px rgba(0,0,0,.05);
}
.t-snav__row {
  display: flex; gap: 2px; overflow-x: auto;
  scrollbar-width: none; padding: 7px 16px;
  scroll-behavior: smooth;
}
.t-snav__row::-webkit-scrollbar { display: none; }
.t-sn {
  font-size: .79rem; font-weight: 600; color: #64748B;
  text-decoration: none; padding: 4px 10px;
