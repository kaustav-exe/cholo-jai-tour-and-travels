}
@keyframes pulse-dot {
  0% { box-shadow: 0 0 0 0 rgba(242,100,25,0.4); }
  70% { box-shadow: 0 0 0 8px rgba(242,100,25,0); }
  100% { box-shadow: 0 0 0 0 rgba(242,100,25,0); }
