}
.t-vstrip__txt svg { width: 13px !important; height: 13px !important; }

/* ══════════════════════════════════════════════════════════════
   JOURNEY ROADMAP + SCHEDULE (merged)
══════════════════════════════════════════════════════════════ */
.t-journey .t-card__head h2 { font-size: .95rem; }

.t-track {
  position: relative;
  padding-left: 40px;
}

/* Vertical line */
.t-track__line {
  position: absolute;
  left: 12px; top: 14px; bottom: 14px;
  width: 3px;
  background: #E2E8F0;
  border-radius: 3px;
}
.t-track__line-fill {
  width: 100%;
  height: 0%;
  background: linear-gradient(180deg, #003B73 0%, #F26419 50%, #10B981 100%);
  border-radius: 3px;
  transition: height 0.15s ease-out;
  position: relative;
}
/* Moving Bus / Vehicle Beacon — smooth 60fps lerp via JS */
.t-track__beacon {
  position: absolute;
  left: 1.5px;
  top: 0%;
  width: 26px;
  height: 24px;
  background: #F26419;
  border: 2px solid #fff;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(242,100,25,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  z-index: 60;
  transform: translate(-50%, -50%);
  pointer-events: none;
  will-change: top;
}
.t-track__beacon svg,
.t-track__beacon > svg {
  width: 14px !important;
  height: 14px !important;
  max-width: 14px !important;
  max-height: 14px !important;
  color: #fff !important;
  display: block !important;
  flex-shrink: 0 !important;
}

/* Node — 3D card-flip & glow reveal */
.t-node {
  position: relative;
  margin-bottom: 16px;
  opacity: 0;
  transform: perspective(600px) rotateX(-20deg) translateY(20px);
  transform-origin: top center;
  transition:
    opacity 0.6s ease var(--d, 0ms),
    transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0ms);
  will-change: opacity, transform;
}
.t-node.visible {
  opacity: 1;
  transform: perspective(600px) rotateX(0deg) translateY(0);
}

/* Dot */
.t-dot {
  position: absolute;
  left: -34px; top: 7px;
  width: 24px; height: 24px;
  border-radius: 50%;
