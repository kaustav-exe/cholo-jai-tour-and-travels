/* ══════════════════════════════════════════════════════════════
   CARDS
══════════════════════════════════════════════════════════════ */
.t-card {
  background: #fff;
  border: 1px solid #E2E8F0;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 14px;
}
.t-card__head {
  display: flex; align-items: center; gap: 6px;
  margin-bottom: 12px; padding-bottom: 9px;
  border-bottom: 1px solid #F1F5F9;
}
.t-card__head--toggle {
  cursor: pointer;
  user-select: none;
  justify-content: space-between;
}
.t-card__head-title {
  display: flex; align-items: center; gap: 6px;
}
.t-card__toggle-btn {
  background: #F1F5F9;
  border: none;
  border-radius: 50%;
  width: 26px;
  height: 26px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #003B73;
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s ease;
}
.t-card__head--toggle:hover .t-card__toggle-btn {
  background: #E2E8F0;
}
.t-card.is-expanded .t-toggle-icon {
  transform: rotate(180deg);
}

/* Collapsible body with peek preview */
.t-collapsible-body {
  max-height: 52px;
  overflow: hidden;
  position: relative;
  transition: max-height 0.45s cubic-bezier(0.16, 1, 0.3, 1);
}
.t-collapsible-body::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 24px;
  background: linear-gradient(transparent, #fff);
  pointer-events: none;
  transition: opacity 0.3s ease;
}
.t-card.is-expanded .t-collapsible-body {
  max-height: 1500px !important;
}
.t-card.is-expanded .t-collapsible-body::after {
  opacity: 0 !important;
}

/* ══════════════════════════════════════════════════════════════
   HIGHLIGHTS
══════════════════════════════════════════════════════════════ */
.t-hl-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px;
}
@media (max-width: 500px) { .t-hl-grid { grid-template-columns: 1fr; } }
.t-hl-item {
  display: flex; align-items: flex-start; gap: 7px;
  background: #F8FAFC; border: 1px solid #E2E8F0;
  padding: 8px 10px; border-radius: 8px;
