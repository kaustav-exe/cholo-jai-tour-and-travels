}
.t-hl-chk { color: #10B981; flex-shrink: 0; margin-top: 1px; width: 13px; height: 13px; }
.t-hl-item svg { width: 13px !important; height: 13px !important; }

/* ══════════════════════════════════════════════════════════════
   GALLERY
══════════════════════════════════════════════════════════════ */
.t-gal {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 7px; margin-bottom: 9px;
}
@media (max-width: 480px) { .t-gal { grid-template-columns: repeat(2, 1fr); } }
.t-gal__thumb { height: 72px; border-radius: 7px; overflow: hidden; background: #E2E8F0; }
.t-gal__thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
.t-gal__thumb:hover img { transform: scale(1.06); }

.t-vstrip {
  display: flex; align-items: center; justify-content: space-between;
  background: #F8FAFC; border: 1px solid #E2E8F0;
  border-radius: 7px; padding: 7px 10px; gap: 8px; flex-wrap: wrap;
}
.t-vstrip__txt {
