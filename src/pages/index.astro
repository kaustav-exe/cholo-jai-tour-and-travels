---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/HeroSlider.astro';
import IntroVideo from '../components/IntroVideo.astro';
import PackageCard from '../components/PackageCard.astro';
import { packages } from '../data/packages';
import { aboutData, siteConfig } from '../data/siteConfig';
import { getPackagePriceForMonth, getCurrentMonthName, getWhatsAppBookingUrl } from '../utils/pricing';
import { Shield, Award, Map, Users, ArrowRight, Calendar, Sparkles } from 'lucide-astro';

const allPackages = packages;

// Resolve Andaman 6N/7D package for dynamic seasonal banner
const andamanPkg = packages.find(p => p.id === 'andaman-6n7d') || packages[0];
const andamanPricing = getPackagePriceForMonth(andamanPkg);
const currentMonth = getCurrentMonthName();
const andamanWaUrl = getWhatsAppBookingUrl(andamanPkg.title, currentMonth, andamanPricing.formattedPrice);

// Popular destinations mapping with live pricing
const popularIds = ['andaman-6n7d', 'pkg-1', 'pkg-4', 'pkg-5', 'pkg-10', 'pkg-9'];
const popularDestinations = popularIds.map(id => {
  const pkg = packages.find(p => p.id === id);
  if (!pkg) return null;
  const pricing = getPackagePriceForMonth(pkg);
  return { pkg, pricing };
}).filter(Boolean);

// JSON-LD Schema for SEO
const schemaData = {
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  "name": siteConfig.name,
  "description": "Government Registered Travel Agency in Kolkata offering curated tour packages for Andaman, Kashmir, Sikkim, Shimla Manali, Rajasthan, Kerala, Meghalaya, Spiti Valley, Char Dham, and Nepal.",
  "url": "https://cholo-jai-tour-and-travels.vercel.app/",
  "telephone": "+919830905332",
  "email": siteConfig.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "R. N. Avenue, Sodepur, Near Deshbandhu School",
    "addressLocality": "Kolkata",
    "addressRegion": "West Bengal",
    "postalCode": "700110",
    "addressCountry": "IN"
  },
  "priceRange": "₹5,700 - ₹38,990"
};
---

<BaseLayout>
  <IntroVideo />
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <!-- Hero Slider -->
  <HeroSlider />

  <!-- Dynamic Seasonal Promotional Banner -->
  <div class="book-banner">
    <div class="container book-banner-inner">
      <div class="book-banner-text">
        <span class="book-banner-icon"><Sparkles size={20} class="sparkle-icon" /></span>
        <div>
          <strong class="banner-headline">
            {currentMonth} Special Offer — {andamanPkg.title} ({andamanPkg.duration})
          </strong>
          <span class="banner-subtext">
            {currentMonth} departures available from <strong>{andamanPricing.formattedPrice} / person</strong> (Includes Flight, AC Hotels, Cruise & Meals)
          </span>
        </div>
      </div>
      <div class="banner-actions">
        <a href={`/packages/${andamanPkg.id}`} class="book-banner-btn-secondary">
          View Package
        </a>
        <a href={andamanWaUrl} target="_blank" rel="noopener" class="book-banner-btn">
          Book {currentMonth} Fare →
        </a>
      </div>
    </div>
  </div>

  <!-- Booking Modal -->
  <div class="modal-overlay" id="booking-modal" aria-hidden="true">
    <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <button class="modal-close" id="close-booking-modal" aria-label="Close" type="button">✕</button>
      <h2 id="modal-title" class="modal-title">Book Your Tour</h2>
      <p class="modal-sub">Fill the form &amp; our team will reach you within 2 hours</p>
      <form class="booking-form" id="booking-form">
        <div class="form-row">
          <div class="form-group">
            <label for="bf-name">Full Name *</label>
            <input type="text" id="bf-name" name="name" placeholder="Your full name" required />
          </div>
          <div class="form-group">
            <label for="bf-phone">Phone Number *</label>
            <input type="tel" id="bf-phone" name="phone" placeholder="+91 98xxx xxxxx" required />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="bf-dest">Destination *</label>
            <select id="bf-dest" name="destination" required>
              <option value="">Select destination</option>
              <option>Tropical Andaman (Flight Included)</option>
              <option>Enchanting Kashmir Winter &amp; Snow Tour</option>
              <option>North Sikkim &amp; Gangtok Tour</option>
              <option>Shimla – Kullu – Manali</option>
              <option>Majestic Rajasthan Royal Tour</option>
              <option>Kerala &amp; Kanyakumari Grand Tour</option>
              <option>Vizag &amp; Araku Valley Tour</option>
              <option>Meghalaya, Shillong, Dawki &amp; Cherrapunji</option>
              <option>Arunachal &amp; Kaziranga Snowfall Expedition</option>
              <option>Haridwar – Mussoorie – Dehradun</option>
              <option>Char Dham &amp; Do Dham Yatra</option>
              <option>Ayodhya – Varanasi – Kashi – Prayagraj</option>
              <option>Puri Seaside &amp; Heritage Tour</option>
              <option>Lahaul &amp; Spiti Valley Circuit</option>
              <option>Nepal Himalayan Tour</option>
              <option>Other / Customized Tour</option>
            </select>
          </div>
          <div class="form-group">
            <label for="bf-date">Travel Month / Date</label>
            <input type="date" id="bf-date" name="date" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="bf-guests">No. of Guests</label>
            <input type="number" id="bf-guests" name="guests" min="1" max="50" placeholder="2" />
          </div>
          <div class="form-group">
            <label for="bf-budget">Budget (per person)</label>
            <select id="bf-budget" name="budget">
              <option value="">Select budget</option>
              <option>Under ₹15,000</option>
              <option>₹15,000 – ₹30,000</option>
              <option>₹30,000 – ₹45,000</option>
              <option>Above ₹45,000</option>
            </select>
          </div>
        </div>
        <div class="form-group full">
          <label for="bf-msg">Message (optional)</label>
          <textarea id="bf-msg" name="message" rows="3" placeholder="Any special requirements..."></textarea>
        </div>
        <button type="submit" class="form-submit">Send Enquiry via WhatsApp</button>
      </form>
    </div>
  </div>

  <!-- Popular Destinations -->
  <section class="section" id="destinations">
    <div class="dest-header container">
      <div>
        <h2>Popular Destinations</h2>
        <p>Dynamic seasonal rates for {currentMonth} departures</p>
      </div>
      <a href="/packages" class="dest-all-link">View All Tours →</a>
    </div>

    <div class="dest-scroll-wrap">
      <div class="dest-scroll-track">
        {popularDestinations.map(({ pkg, pricing }, idx) => (
          <a href={`/packages/${pkg.id}`} class="ds-card" style={`--i:${idx}`}>
            <img src={pkg.image} alt={pkg.title} loading="lazy" />
            <div class="ds-overlay">
              <span class="ds-tag">{pkg.duration}</span>
              <div class="ds-bottom">
                <h3>{pkg.title}</h3>
                <p class="ds-sub">{currentMonth} Fare: {pricing.formattedPrice} / person</p>
                <div class="ds-actions">
                  <span class="ds-btn ds-btn-details">View Details &amp; Pricing →</span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Tours — ALL 14 -->
  <section class="section bg-light" id="featured-tours">
    <div class="container">
      <div class="section-header text-center scroll-anim">
        <h2>Featured Tours</h2>
        <p>Our complete collection of premium travel packages</p>
      </div>
      <div class="tours-grid">
        {allPackages.map((pkg, i) => (
          <div class="tour-wrap scroll-anim" style={`--i:${i}`}>
            <PackageCard pkg={pkg} />
          </div>
        ))}
      </div>
      <div class="featured-footer scroll-anim">
        <a href="/packages" class="btn-explore-more">
          <span>Explore More Tours</span>
          <ArrowRight size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section">
    <div class="container">
      <div class="section-header text-center scroll-anim">
        <h2>Why Choose Us</h2>
        <p>We provide the best travel experiences with premium services</p>
      </div>
      <div class="grid grid-4 features-grid">
        <div class="feature-card scroll-anim" style="--i:0">
          <div class="feature-icon"><Shield size={32} /></div>
          <h3>Safe Travel</h3>
          <p>Your safety is our top priority. We ensure secure and comfortable journeys.</p>
        </div>
        <div class="feature-card scroll-anim" style="--i:1">
          <div class="feature-icon"><Award size={32} /></div>
          <h3>Premium Quality</h3>
          <p>We don't compromise on quality. Best hotels and transport guaranteed.</p>
        </div>
        <div class="feature-card scroll-anim" style="--i:2">
          <div class="feature-icon"><Map size={32} /></div>
          <h3>Expert Guides</h3>
          <p>Learn about your destinations with our experienced local tour guides.</p>
        </div>
        <div class="feature-card scroll-anim" style="--i:3">
          <div class="feature-icon"><Users size={32} /></div>
          <h3>Family Friendly</h3>
          <p>Packages designed for all age groups to enjoy together seamlessly.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section stats-section">
    <div class="container">
      <div class="grid grid-4 text-center">
        {aboutData.stats.map((stat, i) => (
          <div class="stat-item scroll-anim" style={`--i:${i}`}>
            <h3 class="stat-value">{stat.value}</h3>
            <p class="stat-label">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="container text-center scroll-anim">
      <h2>Ready for your next adventure?</h2>
      <p>Contact us today and let us plan the perfect holiday for you.</p>
      <a href="https://wa.me/919830905332?text=Hi%2C%20I%20want%20to%20book%20a%20tour%20with%20Cholo%20Jai%20Tour%20%26%20Travels!" target="_blank" rel="noopener" class="btn btn-primary cta-btn">Book on WhatsApp</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Section header ── */
  .section-header { margin-bottom: 50px; }
  .section-header h2 { font-size: 2.5rem; margin-bottom: 15px; }
  .section-header p { color: var(--c-text-muted); font-size: 1.1rem; }
  .bg-light { background-color: var(--c-bg-light); }

  /* ── Book Banner ── */
  .book-banner {
    background: linear-gradient(135deg, var(--c-primary) 0%, #0065c3 100%);
    padding: 14px 0;
  }

  .book-banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .book-banner-text {
    display: flex;
    align-items: center;
    gap: 14px;
    color: #fff;
  }

  .book-banner-icon { 
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: rgba(255,255,255,0.15);
    border-radius: 50%;
    color: #FFD166;
    flex-shrink: 0;
  }

  .banner-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .book-banner-btn-secondary {
    background: rgba(255,255,255,0.15);
    color: #fff;
    font-weight: 600;
    font-family: var(--f-heading);
    padding: 9px 18px;
    border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.4);
    text-decoration: none;
    font-size: 0.9rem;
    white-space: nowrap;
    transition: background 0.2s;
  }

  .book-banner-btn-secondary:hover {
    background: rgba(255,255,255,0.25);
    color: #fff;
  }

  .book-banner-btn {
    background: #F26419;
    color: #fff;
    font-weight: 700;
    font-family: var(--f-heading);
    padding: 10px 22px;
    border-radius: 8px;
    border: none;
    text-decoration: none;
    cursor: pointer;
    font-size: 0.95rem;
    white-space: nowrap;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .book-banner-btn:hover {
    background: #e05510;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(242, 100, 25, 0.35);
  }

  /* ── Modal ── */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(4px);
    z-index: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .modal-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-box {
    background: #fff;
    border-radius: 20px;
    padding: 32px 28px;
    width: 100%;
    max-width: 560px;
    max-height: 90dvh;
    overflow-y: auto;
    position: relative;
    transform: translateY(20px);
    transition: transform 0.3s ease;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }

  .modal-overlay.open .modal-box { transform: translateY(0); }

  .modal-close {
    position: absolute;
    top: 14px;
    right: 14px;
    background: #f4f4f4;
    border: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .modal-close:hover { background: #e0e0e0; }

  .modal-title {
    font-size: 1.5rem;
    margin-bottom: 4px;
    color: var(--c-primary);
  }

  .modal-sub {
    color: var(--c-text-muted);
    font-size: 0.88rem;
    margin-bottom: 22px;
  }

  /* Form styles */
  .booking-form { display: flex; flex-direction: column; gap: 16px; }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-group.full { grid-column: 1 / -1; }

  .form-group label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--c-text);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    border: 1.5px solid var(--c-border);
    border-radius: 8px;
    padding: 9px 12px;
    font-size: 0.9rem;
    font-family: var(--f-body);
    color: var(--c-text);
    background: #fff;
    transition: border-color 0.2s;
    width: 100%;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--c-primary);
  }

  .form-submit {
    background: #25D366;
    color: #fff;
    font-weight: 700;
    font-family: var(--f-heading);
    padding: 13px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    font-size: 1rem;
    transition: background 0.2s, transform 0.2s;
  }

  .form-submit:hover {
    background: #1aa84f;
    transform: translateY(-1px);
  }

  @media (max-width: 480px) {
    .form-row { grid-template-columns: 1fr; }
    .modal-box { padding: 24px 18px; }
    .book-banner-text span { display: none; }
  }

  /* ── Destinations ── */
  .dest-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 20px;
  }

  .dest-header h2 { font-size: 2rem; margin-bottom: 4px; }
  .dest-header p { color: var(--c-text-muted); font-size: 0.9rem; }

  .dest-all-link {
    font-weight: 600;
    color: var(--c-accent);
    text-decoration: none;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .dest-scroll-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 4px 0 12px;
    margin: 0;
  }

  .dest-scroll-wrap::-webkit-scrollbar { display: none; }

  .dest-scroll-track {
    display: flex;
    gap: 14px;
    width: max-content;
    padding: 4px 4px 6px;
  }

  .ds-card {
    position: relative;
    width: 205px;
    height: 295px;
    border-radius: 18px;
    overflow: hidden;
    flex-shrink: 0;
    cursor: pointer;
    box-shadow: 0 4px 18px rgba(0,0,0,0.14);
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.45s ease calc(var(--i, 0) * 70ms),
                transform 0.45s ease calc(var(--i, 0) * 70ms),
                box-shadow 0.3s;
  }

  .ds-card.visible { opacity: 1; transform: translateY(0); }
  .ds-card:hover { box-shadow: 0 10px 32px rgba(0,0,0,0.24); }

  .ds-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
    display: block;
  }

  .ds-card:hover img { transform: scale(1.07); }

  .ds-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 30%, rgba(0,0,0,0.85) 100%);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 12px;
  }

  .ds-tag {
    align-self: flex-start;
    background: rgba(255,255,255,0.9);
    color: #222;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 20px;
  }

  .ds-bottom { display: flex; flex-direction: column; gap: 4px; }

  .ds-bottom h3 {
    color: #fff;
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0;
  }

  .ds-sub { color: rgba(255,255,255,0.78); font-size: 0.7rem; margin: 0; }

  .ds-book {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #25D366;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 5px 10px;
    border-radius: 20px;
    text-decoration: none;
    width: fit-content;
    transition: background 0.2s, transform 0.2s;
  }

  .ds-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
  }

  .ds-btn {
    border: none;
    cursor: pointer;
    font-family: var(--f-heading);
    transition: transform 0.2s, filter 0.2s;
  }

  .ds-btn-details {
    background: #F26419;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 5px 10px;
    border-radius: 20px;
  }

  .ds-btn-details:hover {
    background: #e05510;
    transform: translateY(-1px);
  }

  /* Featured Footer Explore More */
  .featured-footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 32px;
  }

  .btn-explore-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #003B73;
    color: #ffffff;
    padding: 12px 26px;
    border-radius: 12px;
    font-family: var(--f-heading);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 59, 115, 0.2);
    transition: all 0.25s ease;
  }

  .btn-explore-more:hover {
    background: #F26419;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(242, 100, 25, 0.35);
  }

  .ds-book:hover { background: #1aa84f; }

  @media (max-width: 640px) {
    .ds-card { width: 165px; height: 245px; }
    .dest-scroll-track { gap: 10px; }
  }

  /* ── Featured tours grid ── */
  .tours-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 900px) {
    .tours-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .tours-grid { grid-template-columns: 1fr; }
  }

  /* ── Scroll animations ── */
  .scroll-anim {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.5s ease calc(var(--i, 0) * 55ms),
                transform 0.5s ease calc(var(--i, 0) * 55ms);
  }

  .scroll-anim.visible { opacity: 1; transform: translateY(0); }

  /* ── Feature cards ── */
  .feature-card { text-align: center; padding: 30px 20px; }

  .feature-icon {
    width: 70px;
    height: 70px;
    background: var(--c-bg-light);
    color: var(--c-accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 18px;
    transition: var(--transition);
  }

  .feature-card:hover .feature-icon {
    background: var(--c-accent);
    color: #fff;
    transform: translateY(-5px);
  }

  .feature-card h3 { font-size: 1.2rem; margin-bottom: 12px; }
  .feature-card p { color: var(--c-text-muted); }

  /* ── Stats ── */
  .stats-section { background: var(--c-primary); color: #fff; }
  .stat-value { font-size: 2.8rem; color: #fff; margin-bottom: 8px; }
  .stat-label { opacity: 0.8; font-size: 1rem; text-transform: uppercase; letter-spacing: 1px; }

  /* ── CTA ── */
  .cta-section { background: var(--c-bg-light); padding: 90px 0; }
  .cta-section h2 { font-size: 2.4rem; margin-bottom: 16px; }
  .cta-section p { font-size: 1.1rem; color: var(--c-text-muted); margin-bottom: 36px; }
  .cta-btn { font-size: 1.05rem; padding: 14px 38px; }
</style>

<script>
  function initPage() {
    // ── Booking modal ──
    const openBtn  = document.getElementById('open-booking-modal');
    const modal    = document.getElementById('booking-modal');
    const closeBtn = document.getElementById('close-booking-modal');
    const form     = document.getElementById('booking-form') as HTMLFormElement | null;

    function openModal() {
      modal?.classList.add('open');
      modal?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal?.classList.remove('open');
      modal?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name  = data.get('name') || '';
      const phone = data.get('phone') || '';
      const dest  = data.get('destination') || 'Not specified';
      const date  = data.get('date') || 'Flexible';
      const guests = data.get('guests') || '1';
      const budget = data.get('budget') || 'Not specified';
      const msg   = data.get('message') || '';

      const text = encodeURIComponent(
        `Hi! I want to book a tour 🙏\n\n` +
        `👤 Name: ${name}\n📞 Phone: ${phone}\n📍 Destination: ${dest}\n` +
        `📅 Travel Date: ${date}\n👥 Guests: ${guests}\n💰 Budget: ${budget}` +
        (msg ? `\n📝 Note: ${msg}` : '')
      );

      window.open(`https://wa.me/919830905332?text=${text}`, '_blank');
      closeModal();
      form.reset();
    });

    // ── Scroll animations (IntersectionObserver) ──
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.07 }
    );

    document.querySelectorAll('.ds-card, .scroll-anim').forEach((el) => io.observe(el));
  }

  document.addEventListener('astro:page-load', initPage);
  initPage();
</script>
